# ==============================================================================
# HCMC HISTORY MUSEUM 3D PLATFORM — ENVIRONMENT CONFIGURATION (PRODUCTION CLOUD)
# ==============================================================================
# COPY THIS FILE TO .env.production ON YOUR PRODUCTION SERVER
# DO NOT COMMIT THE ACTUAL .env.production FILE TO GIT!
# ==============================================================================

# Node Production Mode
NODE_ENV=production
PORT=8080
WEB_PORT=8081
ADMIN_PORT=8082

# Keycloak Identity Server (Production HTTPS)
KEYCLOAK_URL=https://auth.hcmc-museum.gov.vn
KEYCLOAK_REALM=hcmc-museum-prod
KEYCLOAK_CLIENT_ID=hcmc-museum-prod-client
KEYCLOAK_CLIENT_SECRET=

# Managed PostgreSQL Database + pgvector (AWS RDS / Cloud SQL)
DATABASE_URL=YOUR_PRODUCTION_POSTGRESQL_CONNECTION_STRING_HERE
DB_MAX_CONNECTIONS=50

# AI Service & Hybrid RAG Engine (Production Kubernetes / Cloud Run)
AI_SERVICE_URL=https://ai.hcmc-museum.gov.vn
GEMINI_API_KEY=
OPENAI_API_KEY=

# Passwordless OTP Gateway (Production SMS & Email Gateway)
OTP_EXPIRY_SECONDS=180
OTP_DEMO_CODE=

# Production Managed Redis (ElastiCache / MemoryStore)
REDIS_URL=rediss://prod-redis.hcmc-museum.gov.vn:6379/0
