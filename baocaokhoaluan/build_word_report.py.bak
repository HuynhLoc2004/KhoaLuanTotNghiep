LOGO_PATH = os.path.join(ASSETS_DIR, "iuh_logo.png")
IMAGE_MINDMAP = os.path.join(ASSETS_DIR, "hinh_1_1_so_do_tu_duy_tong_quan.png")

COLOR_BLACK = (0, 0, 0)

# =============================================================================
# CÁC HÀM TIỆN ÍCH ĐỊNH DẠNG CHUẨN MỰC
# =============================================================================

def set_cell_margins(cell, top=100, bottom=100, left=140, right=140):
    tcPr = cell._tc.get_or_add_tcPr()
    tcMar = OxmlElement('w:tcMar')
    for m, val in [('top', top), ('bottom', bottom), ('left', left), ('right', right)]:
        node = OxmlElement(f'w:{m}')
        node.set(qn('w:w'), str(val))
        node.set(qn('w:type'), 'dxa')
        tcMar.append(node)
    tcPr.append(tcMar)

def set_cell_vertical_alignment(cell, align="center"):
    tcPr = cell._tc.get_or_add_tcPr()
    valign = parse_xml(f'<w:vAlign {nsdecls("w")} w:val="{align}"/>')
    tcPr.append(valign)

def set_cell_background(cell, fill_hex):
    tcPr = cell._tc.get_or_add_tcPr()
    shd = parse_xml(f'<w:shd {nsdecls("w")} w:fill="{fill_hex}"/>')
    tcPr.append(shd)

def set_table_borders(table, color="000000", sz="6", val="single"):
    tblPr = table._tbl.tblPr
    borders = parse_xml(f'''
        <w:tblBorders {nsdecls("w")}>
            <w:top w:val="{val}" w:sz="{sz}" w:space="0" w:color="{color}"/>
            <w:bottom w:val="{val}" w:sz="{sz}" w:space="0" w:color="{color}"/>
            <w:left w:val="{val}" w:sz="{sz}" w:space="0" w:color="{color}"/>
            <w:right w:val="{val}" w:sz="{sz}" w:space="0" w:color="{color}"/>
            <w:insideH w:val="{val}" w:sz="{sz}" w:space="0" w:color="{color}"/>
            <w:insideV w:val="{val}" w:sz="{sz}" w:space="0" w:color="{color}"/>
        </w:tblBorders>
    ''')
    tblPr.append(borders)

def set_table_no_borders(table):
    tblPr = table._tbl.tblPr
    borders = parse_xml(f'''
        <w:tblBorders {nsdecls("w")}>
            <w:top w:val="none"/>
            <w:bottom w:val="none"/>
            <w:left w:val="none"/>
            <w:right w:val="none"/>
            <w:insideH w:val="none"/>
            <w:insideV w:val="none"/>
        </w:tblBorders>
    ''')
    tblPr.append(borders)

def make_row_cant_split(row):
    trPr = row._tr.get_or_add_trPr()
    trPr.append(parse_xml(f'<w:cantSplit {nsdecls("w")}/>'))

def make_row_header(row):
    trPr = row._tr.get_or_add_trPr()
    trPr.append(parse_xml(f'<w:tblHeader {nsdecls("w")}/>'))

def setup_page_layout(section, top_cm=2.0, bottom_cm=2.0, left_cm=3.0, right_cm=2.0):
    section.page_width = Inches(21.0 / 2.54)
    section.page_height = Inches(29.7 / 2.54)
    section.top_margin = Inches(top_cm / 2.54)
    section.bottom_margin = Inches(bottom_cm / 2.54)
    section.left_margin = Inches(left_cm / 2.54)
    section.right_margin = Inches(right_cm / 2.54)

def format_paragraph(p, space_before=3, space_after=0, line_spacing=1.5, align=WD_ALIGN_PARAGRAPH.JUSTIFY, first_indent=0.76, left_indent=0.0):
    p.paragraph_format.space_before = Pt(space_before)
    p.paragraph_format.space_after = Pt(space_after)
    p.paragraph_format.line_spacing = line_spacing
    p.alignment = align
    if first_indent != 0:
        p.paragraph_format.first_line_indent = Cm(first_indent)
    else:
        p.paragraph_format.first_line_indent = 0
    if left_indent != 0:
        p.paragraph_format.left_indent = Cm(left_indent)
    else:
        p.paragraph_format.left_indent = 0

def set_run_font(run, font_name="Times New Roman", size_pt=13, bold=False, italic=False, color_rgb=COLOR_BLACK):
    run.font.name = font_name
    run.font.size = Pt(size_pt)
    run.bold = bold
    run.italic = italic
    run.font.color.rgb = RGBColor(*color_rgb)

def add_body_p(doc, text, space_before=3, space_after=0, line_spacing=1.5):
    """Đoạn văn thân bài chuẩn IUH: Thụt đầu dòng 0.76cm, căn đều 2 bên, Before 3pt, After 0pt, dãn dòng 1.5 lines."""
    p = doc.add_paragraph()
    format_paragraph(p, space_before=space_before, space_after=space_after, line_spacing=line_spacing, align=WD_ALIGN_PARAGRAPH.JUSTIFY, first_indent=0.76, left_indent=0.0)
    run = p.add_run(text)
    set_run_font(run, "Times New Roman", 13, bold=False, italic=False, color_rgb=COLOR_BLACK)
    return p

def add_bullet_item(doc, text, bold_prefix="", space_before=2, space_after=2):
    """Mục gạch đầu dòng: Thụt lề treo chuẩn 0.76cm, dấu gạch ngang tại -0.5cm, dãn dòng 1.5 lines."""
    p = doc.add_paragraph()
    format_paragraph(p, space_before=space_before, space_after=space_after, line_spacing=1.5, align=WD_ALIGN_PARAGRAPH.JUSTIFY, first_indent=-0.5, left_indent=0.76)
    if bold_prefix:
        set_run_font(p.add_run(bold_prefix), "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)
    set_run_font(p.add_run(text), "Times New Roman", 13, bold=False, italic=False, color_rgb=COLOR_BLACK)
    return p

def add_heading_1(doc, text):
    p = doc.add_paragraph()
    format_paragraph(p, space_before=12, space_after=6, line_spacing=1.5, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    p.paragraph_format.keep_with_next = True
    set_run_font(p.add_run(text), "Times New Roman", 14, bold=True, italic=False, color_rgb=COLOR_BLACK)
    return p

def add_heading_2(doc, text):
    p = doc.add_paragraph()
    format_paragraph(p, space_before=8, space_after=2, line_spacing=1.5, align=WD_ALIGN_PARAGRAPH.LEFT, first_indent=0.0, left_indent=0.0)
    p.paragraph_format.keep_with_next = True
    set_run_font(p.add_run(text), "Times New Roman", 13, bold=True, italic=False, color_rgb=COLOR_BLACK)
    return p

def add_heading_3(doc, text):
    p = doc.add_paragraph()
    format_paragraph(p, space_before=6, space_after=2, line_spacing=1.5, align=WD_ALIGN_PARAGRAPH.LEFT, first_indent=0.0, left_indent=0.0)
    p.paragraph_format.keep_with_next = True
    set_run_font(p.add_run(text), "Times New Roman", 13, bold=True, italic=False, color_rgb=COLOR_BLACK)
    return p
    set_run_font(p.add_run(text), "Times New Roman", 13, bold=True, italic=False, color_rgb=COLOR_BLACK)
    return p

def add_math_formula(doc, formula_text):
    """Hiển thị công thức toán căn giữa, chữ nghiêng Times New Roman 12.5pt trang nhã."""
    p = doc.add_paragraph()
    format_paragraph(p, space_before=3, space_after=3, line_spacing=1.2, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    p.paragraph_format.keep_with_next = True
    set_run_font(p.add_run(formula_text), "Times New Roman", 12.5, italic=True, color_rgb=COLOR_BLACK)
    return p

def add_dotted_line(doc, count=148):
    p = doc.add_paragraph()
    format_paragraph(p, space_before=1, space_after=2, line_spacing=1.1, align=WD_ALIGN_PARAGRAPH.LEFT, first_indent=0.0, left_indent=0.0)
    run = p.add_run("." * count)
    set_run_font(run, "Times New Roman", 10.5, color_rgb=COLOR_BLACK)
    return p

def add_clean_signature_block(doc, left_title, left_name, right_date, right_title, right_name):
    t = doc.add_table(rows=1, cols=2)
    t.alignment = WD_TABLE_ALIGNMENT.CENTER
    t.autofit = False
    set_table_no_borders(t)

    c1 = t.cell(0, 0)
    c2 = t.cell(0, 1)
    c1.width = Inches(3.0)
    c2.width = Inches(3.5)

    p1 = c1.paragraphs[0]
    format_paragraph(p1, space_before=4, space_after=2, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    p1.paragraph_format.keep_with_next = True
    r = p1.add_run(left_title + "\n\n\n")
    set_run_font(r, "Times New Roman", 13, bold=True, italic=True, color_rgb=COLOR_BLACK)
    r_name = p1.add_run(left_name)
    set_run_font(r_name, "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)

    p2 = c2.paragraphs[0]
    format_paragraph(p2, space_before=2, space_after=2, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    p2.paragraph_format.keep_with_next = True
    r_date = p2.add_run(right_date + "\n")
    set_run_font(r_date, "Times New Roman", 12.5, italic=True, color_rgb=COLOR_BLACK)
    r_title = p2.add_run(right_title + "\n\n\n")
    set_run_font(r_title, "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)
    r_name2 = p2.add_run(right_name)
    set_run_font(r_name2, "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)

    for row in t.rows:
        for cell in row.cells:
            set_cell_margins(cell, top=10, bottom=10, left=30, right=30)

def add_page_number(run):
    fld1 = OxmlElement('w:fldChar')
    fld1.set(qn('w:fldCharType'), 'begin')
    instr = OxmlElement('w:instrText')
    instr.set(qn('xml:space'), 'preserve')
    instr.text = 'PAGE'
    fld2 = OxmlElement('w:fldChar')
    fld2.set(qn('w:fldCharType'), 'separate')
    fld3 = OxmlElement('w:fldChar')
    fld3.set(qn('w:fldCharType'), 'end')
    run._r.append(fld1)
    run._r.append(instr)
    run._r.append(fld2)
    run._r.append(fld3)

def add_reference_item(doc, ref_num_str, author_part, title_part, pub_part):
    p = doc.add_paragraph()
    format_paragraph(p, space_before=3, space_after=3, line_spacing=1.5, align=WD_ALIGN_PARAGRAPH.JUSTIFY, first_indent=-1.0, left_indent=1.0)
    p.paragraph_format.keep_with_next = False
    r_num = p.add_run(ref_num_str + " ")
    set_run_font(r_num, "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)
    r_auth = p.add_run(author_part + ", ")
    set_run_font(r_auth, "Times New Roman", 13, bold=False, color_rgb=COLOR_BLACK)
    if title_part.startswith('"'):
        r_title = p.add_run(title_part + ", ")
        set_run_font(r_title, "Times New Roman", 13, bold=False, italic=False, color_rgb=COLOR_BLACK)
        r_pub = p.add_run(pub_part)
        set_run_font(r_pub, "Times New Roman", 13, bold=False, italic=True, color_rgb=COLOR_BLACK)
    else:
        r_title = p.add_run(title_part + ". ")
        set_run_font(r_title, "Times New Roman", 13, bold=False, italic=True, color_rgb=COLOR_BLACK)
        r_pub = p.add_run(pub_part)
        set_run_font(r_pub, "Times New Roman", 13, bold=False, italic=False, color_rgb=COLOR_BLACK)
    return p

def add_centered_image(doc, img_path, caption, width_cm=14.5):
    if os.path.exists(img_path):
        p_img = doc.add_paragraph()
        format_paragraph(p_img, space_before=8, space_after=3, line_spacing=1.0, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
        p_img.paragraph_format.keep_with_next = True
        p_img.add_run().add_picture(img_path, width=Cm(width_cm))
        
        p_cap = doc.add_paragraph()
        format_paragraph(p_cap, space_before=2, space_after=8, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
        set_run_font(p_cap.add_run(caption), "Times New Roman", 11.5, bold=False, italic=True, color_rgb=COLOR_BLACK)

def add_placeholder_box_word(doc, caption, width_cm=14.5,
                             label="KHU VỰC DÀNH CHO NHÓM TÁC GIẢ CHÈN ẢNH CHỤP THỰC TẾ",
                             note="Kéo thả hoặc nhấp chọn ảnh chụp thực tế của nhóm tại Bảo tàng Lịch sử TP.HCM để chèn vào khung này (Tỷ lệ 16:9 hoặc 4:3)"):
    tbl = doc.add_table(rows=1, cols=1)
    tbl.alignment = WD_TABLE_ALIGNMENT.CENTER
    cell = tbl.cell(0, 0)
    cell.width = Cm(width_cm)

    shading = parse_xml(f'<w:shd {nsdecls("w")} w:fill="F8FAFC"/>')
    cell._tc.get_or_add_tcPr().append(shading)

    tcBorders = parse_xml(f'''<w:tcBorders {nsdecls("w")}>
        <w:top w:val="dashed" w:sz="12" w:space="0" w:color="94A3B8"/>
        <w:left w:val="dashed" w:sz="12" w:space="0" w:color="94A3B8"/>
        <w:bottom w:val="dashed" w:sz="12" w:space="0" w:color="94A3B8"/>
        <w:right w:val="dashed" w:sz="12" w:space="0" w:color="94A3B8"/>
    </w:tcBorders>''')
    cell._tc.get_or_add_tcPr().append(tcBorders)

    p = cell.paragraphs[0]
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.space_before = Pt(28)
    p.paragraph_format.space_after = Pt(28)
    p.paragraph_format.line_spacing = 1.15

    r = p.add_run(f"📷 [ {label} ]\n")
    set_run_font(r, "Times New Roman", 11.5, bold=True, italic=False, color_rgb=(30, 58, 95))

    r2 = p.add_run(f"({note})")
    set_run_font(r2, "Times New Roman", 10.0, bold=False, italic=True, color_rgb=(100, 116, 139))

    p_cap = doc.add_paragraph()
    format_paragraph(p_cap, space_before=4, space_after=8, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    set_run_font(p_cap.add_run(caption), "Times New Roman", 11.5, bold=False, italic=True, color_rgb=COLOR_BLACK)

# =============================================================================
# HÀM XÂY DỰNG TOÀN BỘ TÀI LIỆU
# =============================================================================

def build_report():
    print("Khởi tạo tài liệu Word chuẩn: Căn chỉnh lề đồng bộ, Bảng 2.1 thoáng đãng, font Times New Roman...")
    doc = docx.Document()

    # Kích hoạt chế độ Mirror Margins (lề trang đối xứng in 2 mặt) chuẩn quy chế IUH
    doc.settings.element.append(parse_xml(f'<w:mirrorMargins {nsdecls("w")}/>'))

    # Style default
    style = doc.styles['Normal']
    font = style.font
    font.name = 'Times New Roman'
    font.size = Pt(13)
    font.color.rgb = RGBColor(*COLOR_BLACK)

    # =========================================================================
    # SECTION 1: TRANG BÌA CHÍNH (Tiếng Việt) & BÌA PHỤ (Tiếng Anh)
    # =========================================================================
    sec_cover = doc.sections[0]
    setup_page_layout(sec_cover, top_cm=2.0, bottom_cm=2.0, left_cm=3.0, right_cm=2.0)
    sec_cover.header.is_linked_to_previous = False
    sec_cover.footer.is_linked_to_previous = False
    sec_cover.header.paragraphs[0].text = ""
    sec_cover.footer.paragraphs[0].text = ""

    # Bìa tiếng Việt
    p = doc.add_paragraph()
    format_paragraph(p, 0, 2, 1.1, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p.add_run("BỘ CÔNG THƯƠNG\nTRƯỜNG ĐẠI HỌC CÔNG NGHIỆP THÀNH PHỐ HỒ CHÍ MINH\nKHOA CÔNG NGHỆ THÔNG TIN"), "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)

    p_div = doc.add_paragraph()
    format_paragraph(p_div, 2, 14, 1.0, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p_div.add_run("------------------------"), "Times New Roman", 12, bold=True, color_rgb=COLOR_BLACK)

    if os.path.exists(LOGO_PATH):
        p_logo = doc.add_paragraph()
        format_paragraph(p_logo, 6, 16, 1.0, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
        p_logo.add_run().add_picture(LOGO_PATH, width=Inches(2.2))

    p_kl = doc.add_paragraph()
    format_paragraph(p_kl, 6, 8, 1.1, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p_kl.add_run("BÁO CÁO KHÓA LUẬN TỐT NGHIỆP"), "Times New Roman", 15, bold=True, color_rgb=COLOR_BLACK)

    p_title = doc.add_paragraph()
    format_paragraph(p_title, 6, 16, 1.25, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p_title.add_run("HỆ THỐNG THAM QUAN THỰC TẾ ẢO 360° & SỐ HÓA KHÔNG GIAN DI SẢN BẢO TÀNG LỊCH SỬ TP. HỒ CHÍ MINH"), "Times New Roman", 15.5, bold=True, color_rgb=COLOR_BLACK)

    p_cn = doc.add_paragraph()
    format_paragraph(p_cn, 4, 24, 1.1, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p_cn.add_run("Chuyên ngành: CÔNG NGHỆ THÔNG TIN\nKhóa học: 2022 – 2026 (Khóa 18)"), "Times New Roman", 13, bold=False, italic=True, color_rgb=COLOR_BLACK)

    table_info = doc.add_table(rows=3, cols=2)
    table_info.alignment = WD_TABLE_ALIGNMENT.CENTER
    table_info.autofit = False
    set_table_no_borders(table_info)

    cell_gv_label = table_info.cell(0, 0)
    cell_gv_val = table_info.cell(0, 1)
    cell_gv_label.width = Inches(2.3)
    cell_gv_val.width = Inches(3.8)
    
    p = cell_gv_label.paragraphs[0]
    format_paragraph(p, 0, 2, 1.15, WD_ALIGN_PARAGRAPH.LEFT, 0.0)
    set_run_font(p.add_run("Giảng viên hướng dẫn:"), "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)

    p = cell_gv_val.paragraphs[0]
    format_paragraph(p, 0, 2, 1.15, WD_ALIGN_PARAGRAPH.LEFT, 0.0)
    set_run_font(p.add_run("TS. Trần Thị Minh Khoa"), "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)

    p = table_info.cell(1, 0).paragraphs[0]
    format_paragraph(p, 0, 2, 1.15, WD_ALIGN_PARAGRAPH.LEFT, 0.0)
    set_run_font(p.add_run("Sinh viên thực hiện 1:"), "Times New Roman", 13, bold=False, color_rgb=COLOR_BLACK)

    p = table_info.cell(1, 1).paragraphs[0]
    format_paragraph(p, 0, 2, 1.15, WD_ALIGN_PARAGRAPH.LEFT, 0.0)
    set_run_font(p.add_run("Huỳnh Tấn Lộc – 22686171 (Trưởng nhóm)\nLớp: DHCNTT18ATT"), "Times New Roman", 13, bold=False, color_rgb=COLOR_BLACK)

    p = table_info.cell(2, 0).paragraphs[0]
    format_paragraph(p, 0, 2, 1.15, WD_ALIGN_PARAGRAPH.LEFT, 0.0)
    set_run_font(p.add_run("Sinh viên thực hiện 2:"), "Times New Roman", 13, bold=False, color_rgb=COLOR_BLACK)

    p = table_info.cell(2, 1).paragraphs[0]
    format_paragraph(p, 0, 2, 1.15, WD_ALIGN_PARAGRAPH.LEFT, 0.0)
    set_run_font(p.add_run("Trịnh Vĩ Thành – 22689411\nLớp: DHCNTT18ATT"), "Times New Roman", 13, bold=False, color_rgb=COLOR_BLACK)

    for row in table_info.rows:
        for cell in row.cells:
            set_cell_margins(cell, top=40, bottom=40, left=40, right=40)

    p_bot = doc.add_paragraph()
    format_paragraph(p_bot, 36, 0, 1.0, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p_bot.add_run("TP. HỒ CHÍ MINH, NĂM 2026"), "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)

    doc.add_page_break()

    # Bìa tiếng Anh
    p = doc.add_paragraph()
    format_paragraph(p, 0, 2, 1.1, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p.add_run("MINISTRY OF INDUSTRY AND TRADE\nINDUSTRIAL UNIVERSITY OF HO CHI MINH CITY\nFACULTY OF INFORMATION TECHNOLOGY"), "Times New Roman", 13, bold=True, color_rgb=COLOR_BLACK)

    p_div = doc.add_paragraph()
    format_paragraph(p_div, 2, 14, 1.0, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p_div.add_run("------------------------"), "Times New Roman", 12, bold=True, color_rgb=COLOR_BLACK)

    if os.path.exists(LOGO_PATH):
        p_logo = doc.add_paragraph()
        format_paragraph(p_logo, 6, 16, 1.0, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
        p_logo.add_run().add_picture(LOGO_PATH, width=Inches(2.2))

    p_kl = doc.add_paragraph()
    format_paragraph(p_kl, 6, 8, 1.1, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
