    data_A_1 = [
        ("Giai đoạn 1: Khởi động & Khảo sát (Đợt 1)", "Khảo sát không gian 18 gian phòng trưng bày và các cửa thông phòng; nghiên cứu tài liệu lịch sử và quy định bảo tồn; thiết lập kiến trúc hệ thống tổng thể và đặc tả yêu cầu.", "Huỳnh Tấn Lộc (70%) - Trịnh Vĩ Thành (30%)", "100%"),
        ("Giai đoạn 2: Thuật toán & Thử nghiệm (Đợt 2)", "Xây dựng thuật toán ghép ảnh 360° tự động từ video điện thoại (Cylindrical Warping, RootSIFT, Laplacian); thu thập video mẫu xử lý lệch mí; xây dựng Động cơ 3D CPU Heuristic.", "Huỳnh Tấn Lộc (60%) - Trịnh Vĩ Thành (40%)", "100%"),
        ("Giai đoạn 3: Hiện thực hóa phần mềm (Đợt 3)", "Thu thập trọn vẹn dữ liệu ảnh 360° của 18 phòng và hiện vật; phát triển Three.js WebGL, Mini-map Dijkstra; tích hợp Trợ lý Gemini 2.5 Flash, thanh toán VietQR PayOS và soát vé camera QR.", "Huỳnh Tấn Lộc (50%) - Trịnh Vĩ Thành (50%)", "100%"),
        ("Giai đoạn 4: Thực nghiệm & Báo cáo (Đợt 4)", "Triển khai Cloud VPS; đo đạc FPS, RAM trên mạng di động 4G tại bảo tàng; so sánh thực nghiệm Động cơ 3D CPU Heuristic với GPU TRELLIS; biên soạn toàn văn báo cáo KLTN chuẩn IUH.", "Huỳnh Tấn Lộc (50%) - Trịnh Vĩ Thành (50%)", "100%")
