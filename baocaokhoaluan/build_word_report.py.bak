    # TRANG 3: LỜI CẢM ƠN
    p = doc.add_paragraph()
    format_paragraph(p, 0, 8, 1.25, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p.add_run("LỜI CẢM ƠN"), "Times New Roman", 14, bold=True, color_rgb=COLOR_BLACK)

    add_body_p(doc, "Khóa luận tốt nghiệp là dấu mốc quan trọng khép lại chặng đường học tập tại Trường Đại học Công nghiệp Thành phố Hồ Chí Minh. Để hoàn thành đề tài này, chúng em đã nhận được sự chỉ dạy, hỗ trợ và tạo điều kiện quý báu từ Quý Thầy Cô, Nhà trường và đơn vị thực nghiệm.", space_after=3, line_spacing=1.25)
    add_body_p(doc, "Trước hết, chúng em xin bày tỏ lòng biết ơn sâu sắc đến Cô TS. Trần Thị Minh Khoa – Giảng viên hướng dẫn trực tiếp. Trong suốt quá trình thực hiện khóa luận từ tháng 8 đến tháng 11 năm 2026, Cô đã luôn tận tình định hướng khoa học, theo sát tiến độ, chỉ dẫn chuyên môn và rèn giũa cho chúng em phương pháp làm việc nghiêm túc, chặt chẽ để hoàn thiện hệ thống.", space_after=3, line_spacing=1.25)
    add_body_p(doc, "Chúng em xin chân thành cảm ơn Ban Chủ nhiệm Khoa cùng Quý Thầy Cô trong Khoa Công nghệ Thông tin – Trường Đại học Công nghiệp TP. Hồ Chí Minh đã tận tâm giảng dạy, trang bị nền tảng kiến thức chuyên môn vững chắc trong suốt những năm đại học vừa qua. Đồng thời, nhóm chân thành cảm ơn Ban Giám đốc và các anh chị cán bộ tại Bảo tàng Lịch sử TP.HCM đã tạo điều kiện thuận lợi cho nhóm thực hiện 4 đợt khảo sát tại 18 gian phòng trưng bày.", space_after=3, line_spacing=1.25)
    add_body_p(doc, "Chúng con xin cảm ơn Gia đình luôn là chỗ dựa vững chắc, động viên và tạo điều kiện tốt nhất trong suốt quá trình học tập. Nhóm cũng cảm ơn các bạn sinh viên lớp DHCNTT18ATT đã đồng hành và chia sẻ kinh nghiệm. Dù đã nỗ lực hết mình, đề tài khó tránh khỏi những thiếu sót. Chúng em rất mong nhận được những ý kiến đóng góp quý báu từ Cô cùng Quý Thầy Cô trong Hội đồng để hệ thống tiếp tục được hoàn thiện tốt hơn.", space_after=6, line_spacing=1.25)

    add_clean_signature_block(
