    # TRANG 4: LỜI CAM ĐOAN
    p = doc.add_paragraph()
    format_paragraph(p, 0, 10, 1.3, WD_ALIGN_PARAGRAPH.CENTER, 0.0)
    set_run_font(p.add_run("LỜI CAM ĐOAN"), "Times New Roman", 14, bold=True, color_rgb=COLOR_BLACK)

    add_body_p(doc, "Kính gửi Hội đồng chấm Khóa luận tốt nghiệp – Khoa Công nghệ Thông tin, Trường Đại học Công nghiệp Thành phố Hồ Chí Minh.", space_after=4, line_spacing=1.35)
    add_body_p(doc, "Nhóm sinh viên thực hiện đề tài gồm Huỳnh Tấn Lộc (MSSV: 22686171) và Trịnh Vĩ Thành (MSSV: 22689411), sinh viên lớp DHCNTT18ATT, xin cam đoan trước Hội đồng khoa học các nội dung sau:", space_after=4, line_spacing=1.35)
    add_body_p(doc, "1. Cuốn báo cáo khóa luận tốt nghiệp mang tên \"Hệ thống Tham Quan Thực Tế Ảo 360° & Số Hóa Không Gian Di Sản Bảo Tàng Lịch Sử TP.HCM\" là công trình nghiên cứu, thiết kế và phát triển phần mềm độc lập của hai sinh viên thực hiện, dưới sự hướng dẫn khoa học trực tiếp của Cô TS. Trần Thị Minh Khoa từ tháng 08/2026 đến tháng 11/2026.", space_after=4, line_spacing=1.35)
    add_body_p(doc, "2. Toàn bộ các phân hệ phần mềm — bao gồm giao diện tham quan 360° và kết xuất mô hình 3D trên nền Three.js/React, máy chủ quản trị Node.js Express, hàng đợi Redis, cơ sở dữ liệu MongoDB và mô đun ghép ảnh toàn cảnh Python OpenCV — đều do sinh viên tự nghiên cứu, cài đặt mã nguồn và thử nghiệm. Đề tài tuyệt đối không sao chép mã nguồn của bất kỳ đồ án nào khác.", space_after=4, line_spacing=1.35)
    add_body_p(doc, "3. Dữ liệu không gian của 18 gian phòng trưng bày, các mô hình 3D cổ vật và sơ đồ dẫn đường được sinh viên trực tiếp khảo sát, ghi hình thực tế qua 4 đợt tác nghiệp tại Bảo tàng Lịch sử TP.HCM. Các số liệu đo lường hiệu năng trình bày trong báo cáo là kết quả đo đạc khách quan trên hệ thống đang chạy.", space_after=4, line_spacing=1.35)
    add_body_p(doc, "4. Các công trình khoa học, thuật toán nền tảng cùng các thư viện mã nguồn mở được sử dụng đều được trích dẫn nguồn gốc rõ ràng, tuân thủ đúng chuẩn mực học thuật.", space_after=4, line_spacing=1.35)
    add_body_p(doc, "Sinh viên xin chịu hoàn toàn trách nhiệm trước Hội đồng và Nhà trường nếu phát hiện bất kỳ sự thiếu trung thực nào trong công trình này.", space_after=4, line_spacing=1.35)

