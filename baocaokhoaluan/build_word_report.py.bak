    rf1 = pf1.add_run('Hệ thống tham quan thực tế ảo 360° & số hóa không gian di sản Bảo tàng Lịch sử TP. Hồ Chí Minh')
    set_run_font(rf1, 'Times New Roman', 10.5, bold=True, color_rgb=COLOR_BLACK)

    pf2 = tbl_ftr.rows[0].cells[1].paragraphs[0]
    format_paragraph(pf2, space_before=2, space_after=0, line_spacing=1.0, align=WD_ALIGN_PARAGRAPH.RIGHT, first_indent=0.0, left_indent=0.0)
    rf2 = pf2.add_run()
    set_run_font(rf2, 'Times New Roman', 12, bold=False, color_rgb=COLOR_BLACK)
    add_page_number(rf2)

    # -------------------------------------------------------------------------
    # CHƯƠNG 1: TỔNG QUAN ĐỀ TÀI
    # -------------------------------------------------------------------------
    add_heading_1(doc, "CHƯƠNG 1. TỔNG QUAN ĐỀ TÀI")

    add_heading_2(doc, "1.1. Bối cảnh đề tài và lý do lựa chọn")

    add_heading_3(doc, "1.1.1. Nhu cầu ứng dụng công nghệ không gian 360° và mô hình 3D trên nền web")
    add_body_p(doc, "Trong bối cảnh chuyển đổi số ngành bảo tồn di sản văn hóa, công nghệ đồ họa không gian ba chiều trên nền tảng web đóng vai trò then chốt trong việc mang lại khả năng tiếp cận trực quan cho công chúng. Đề tài tập trung nghiên cứu và ứng dụng hai kỹ thuật hiển thị tương tác chủ đạo:")
    add_bullet_item(doc, " Tái tạo không gian môi trường đa chiều từ một vị trí quan sát cố định. Người xem có thể sử dụng chuột trên máy tính hoặc thao tác chạm vuốt trên màn hình điện thoại để xoay nhìn tự do bốn hướng (trái, phải, trên, dưới), đồng thời nhấp chọn các điểm chuyển phòng (Hotspots) để di chuyển qua lại giữa các không gian như đang bước đi trong thực tế.", bold_prefix="- Công nghệ không gian toàn cảnh thực tế ảo 360 độ (Virtual Tour 360°):")
    add_bullet_item(doc, " Cho phép người xem tiếp cận trực tiếp với vật thể trong không gian số, tự do xoay lật đa chiều, phóng to, thu nhỏ để quan sát tỉ mỉ từng chi tiết hình học, chất liệu và hoa văn bề mặt.", bold_prefix="- Công nghệ hiển thị và tương tác mô hình vật thể ba chiều (3D Models):")
    add_body_p(doc, "Khảo sát trên internet hiện nay cho thấy, phần lớn các trang web giới thiệu di sản, danh lam thắng cảnh và cơ sở văn hóa vẫn chủ yếu sử dụng ảnh chụp 2D tĩnh kèm các đoạn văn bản mô tả phẳng. Cách tiếp cận truyền thống này bộc lộ những hạn chế rõ rệt:")
    add_bullet_item(doc, " Ảnh chụp 2D cố định góc máy khiến người xem bị giới hạn tầm nhìn, không thể cảm nhận được chiều sâu không gian, tỷ lệ khoảng cách và hướng di chuyển trong một quần thể kiến trúc rộng lớn.", bold_prefix="- Về mặt không gian:")
    add_bullet_item(doc, " Ảnh chụp một mặt chỉ phản ánh được một góc chụp đơn lẻ, người xem không thể xoay chuyển để quan sát các góc khuất, các mặt bên hoặc hoa văn chạm khắc ở phía sau hiện vật.", bold_prefix="- Về mặt hiện vật:")

    add_heading_3(doc, "1.1.2. Lý do lựa chọn Bảo tàng Lịch sử TP.HCM làm đối tượng thực nghiệm")
    add_body_p(doc, "Để đưa công nghệ không gian 360 độ và mô hình 3D vào giải quyết một bài toán thực tế có độ phức tạp cao, nhóm đã lựa chọn Bảo tàng Lịch sử TP. Hồ Chí Minh (Số 2 Nguyễn Bỉnh Khiêm, Phường Bến Nghé, Quận 1) làm đối tượng nghiên cứu và thực nghiệm. Bảo tàng là một môi trường ứng dụng hoàn hảo vì hội tụ đầy đủ hai bài toán kỹ thuật mà đề tài hướng đến:")
    add_bullet_item(doc, " Bảo tàng có quy mô lớn với 18 phòng trưng bày nối tiếp nhau theo một lộ trình tham quan khép kín, lưu giữ tiến trình lịch sử Việt Nam từ thời Tiền sử đến triều Nguyễn cùng các nền văn hóa cổ phương Nam. Việc xây dựng một chuyến tham quan ảo 360 độ kết hợp sơ đồ bản đồ thu nhỏ (Mini-map) sẽ giúp học sinh, sinh viên và khách tham quan từ xa có thể hình dung rõ ràng lộ trình, vị trí từng phòng và tự do trải nghiệm bước đi qua từng thời kỳ lịch sử.", bold_prefix="- Về bài toán không gian kiến trúc:")
    add_bullet_item(doc, " Bảo tàng hiện lưu giữ hàng ngàn cổ vật quý báu. Để bảo đảm an toàn chống xuống cấp vật lý do nhiệt độ, ánh sáng và tiếp xúc cơ học, toàn bộ các cổ vật này đều được đặt sau các tủ kính dày và khách tham quan tuyệt đối không được chạm tay vào. Ngay cả khi đến xem trực tiếp tại chỗ, người xem cũng chỉ nhìn được từ một phía. Việc đưa mô hình 3D của cổ vật lên trang web giúp người xem có thể phóng to, xoay lật 360 độ để chiêm ngưỡng trọn vẹn từng đường nét hoa văn tinh xảo ở mọi góc cạnh mà ngoài đời thực không thể thấy được.", bold_prefix="- Về bài toán hiện vật số hóa:")
    add_body_p(doc, "Bên cạnh đó, việc tạo lập các chuyến tham quan ảo hiện nay thường đòi hỏi các thiết bị quét 3D chuyên dụng đắt tiền (như máy quét laser hoặc máy ảnh 360 độ chuyên nghiệp) và phụ thuộc vào nền tảng đám mây đóng có thu phí định kỳ của nước ngoài. Khi bảo tàng thay đổi bài trí hiện vật hoặc mở thêm chuyên đề trưng bày mới, việc thuê lại dịch vụ quét ngoài rất tốn kém và mất nhiều thời gian. Do đó, đề tài phát triển thêm công cụ xử lý ảnh tự động từ video quay bằng điện thoại thông minh thông thường, giúp ban quản trị bảo tàng có thể tự chủ cập nhật không gian phòng trưng bày trên hệ thống máy chủ riêng mà không bị phụ thuộc vào thiết bị đắt tiền bên ngoài.")

    add_centered_image(doc, IMAGE_MINDMAP, "Hình 1.1: Sơ đồ khối kỹ thuật bối cảnh đề tài và giải pháp kết hợp Không gian 360° – Mô hình hiện vật 3D", width_cm=14.5)

    add_heading_2(doc, "1.2. Mục tiêu nghiên cứu và phạm vi triển khai")

    add_heading_3(doc, "1.2.1. Mục tiêu tổng quát và các mục tiêu cụ thể của hệ thống")
    add_body_p(doc, 'Mục tiêu tổng quát của đề tài là nghiên cứu, thiết kế và xây dựng hoàn chỉnh "Hệ thống Tham Quan Thực Tế Ảo 360° & Số Hóa Không Gian Di Sản Bảo Tàng Lịch Sử TP.HCM", hoạt động ổn định trên nền tảng web (tương thích cả máy tính và thiết bị di động), phục vụ nhu cầu tham quan trực quan cho công chúng và cung cấp công cụ quản trị số hóa linh hoạt cho đơn vị quản lý bảo tàng.')
    add_body_p(doc, "Các mục tiêu kỹ thuật cụ thể bao gồm:")
    add_bullet_item(doc, " Xây dựng đường ống (pipeline) xử lý ảnh tự động trên nền Python OpenCV, tiếp nhận video quay phòng bằng điện thoại di động thông thường, trích xuất khung hình rõ nét, nắn phẳng chiếu mặt trụ (Cylindrical Warping), tìm điểm tương đồng bằng SIFT, ước lượng ma trận Homography kết hợp RANSAC và hòa trộn mí nối liền mạch để xuất ra ảnh toàn cảnh 360 độ chuẩn tỷ lệ 2:1.", bold_prefix="1. Làm chủ thuật toán xử lý ảnh 360 độ:")
    add_bullet_item(doc, " Ứng dụng thư viện Three.js và WebGL để kết xuất không gian cầu mượt mà; gắn các điểm chuyển phòng (Hotspots), tích hợp bản đồ nhỏ (Mini-map) có khả năng tìm đường đi ngắn nhất giữa 18 phòng theo thuật toán Dijkstra, kết xuất mô hình 3D cổ vật (.GLB) cho phép xoay phóng tương tác, phát thuyết minh âm thanh đa ngôn ngữ và tích hợp trợ lý hỏi đáp kiến thức lịch sử.", bold_prefix="2. Xây dựng cổng tham quan tương tác 360° & Cổ vật 3D:")
    add_bullet_item(doc, " Cung cấp công cụ quản trị trực quan trên web để ban quản lý có thể tải ảnh/video phòng mới, ghim điểm chuyển phòng trực tiếp trên mặt cầu 360 độ, quản lý thông tin cổ vật; đồng thời tích hợp cổng thanh toán VietQR (PayOS) và phân hệ camera quét mã QR trên điện thoại để nhân viên bảo tàng soát vé khách vào cổng.", bold_prefix="3. Hiện thực hóa phân hệ quản trị Studio & Soát vé QR:")

    add_heading_3(doc, "1.2.2. Đối tượng nghiên cứu và phạm vi thực nghiệm tại 18 gian phòng trưng bày")
    add_body_p(doc, "Đối tượng nghiên cứu của đề tài bao gồm:")
    add_bullet_item(doc, "Nguyên lý chiếu mặt trụ (Cylindrical Warping) và biểu diễn không gian toàn cảnh Equirectangular Projection.", bold_prefix="- ")
    add_bullet_item(doc, "Thuật toán trích xuất đặc trưng bất biến SIFT và thuật toán ước lượng ma trận Homography kết hợp lọc nhiễu RANSAC.", bold_prefix="- ")
    add_bullet_item(doc, "Kỹ thuật kết xuất đồ họa không gian ba chiều trên nền web thông qua WebGL và Three.js.", bold_prefix="- ")
    add_bullet_item(doc, "Kiến trúc phân tầng kết hợp hàng đợi xử lý bất đồng bộ (Redis Queue) giữa máy chủ Node.js Express và dịch vụ xử lý ảnh Python.", bold_prefix="- ")
    add_body_p(doc, "Phạm vi thực nghiệm của đề tài:")
    add_bullet_item(doc, " Thực nghiệm số hóa toàn bộ 18 gian phòng trưng bày thuộc hệ thống tham quan chính thức của Bảo tàng Lịch sử TP.HCM, bao gồm: Phòng Thời Tiền sử, Thời dựng nước Hùng Vương, Thời Bắc thuộc, Văn hóa Champa, Văn hóa Óc Eo - Phù Nam, Các triều đại Ngô - Đinh - Tiền Lê, Lý, Trần, Hậu Lê, Tây Sơn, Triều Nguyễn và các bộ sưu tập mỹ thuật cổ.", bold_prefix="- Không gian kiến trúc:")
    add_bullet_item(doc, " Thu thập và tích hợp mô hình 3D của các cổ vật tiêu biểu đại diện cho các thời kỳ văn hóa lịch sử, phục vụ tương tác trực quan trên trình duyệt.", bold_prefix="- Hiện vật số hóa:")
    add_bullet_item(doc, " Hệ thống được triển khai thực nghiệm trên máy chủ đám mây (Cloud VPS), kiểm thử hiệu năng truy cập trên các trình duyệt phổ biến (Google Chrome, Safari, Microsoft Edge) trên cả máy tính xách tay và thiết bị di động (hệ điều hành Android và iOS).", bold_prefix="- Môi trường thử nghiệm:")

    add_heading_2(doc, "1.3. Phương pháp tiếp cận và cấu trúc báo cáo")

    add_heading_3(doc, "1.3.1. Tiến trình khảo sát, thu thập dữ liệu và thử nghiệm qua 4 đợt tác nghiệp thực tế")
    add_body_p(doc, "Để đảm bảo hệ thống phản ánh đúng thực tế không gian kiến trúc và vận hành ổn định khi đưa vào sử dụng, toàn bộ dữ liệu số hóa và quy trình kiểm thử phần mềm đều được nhóm trực tiếp thực hiện qua 4 đợt tác nghiệp thực tế tại Bảo tàng Lịch sử TP. Hồ Chí Minh:")
    add_bullet_item(doc, " Nhóm trực tiếp đến bảo tàng khảo sát toàn bộ khuôn viên và kiến trúc liên hoàn của 18 phòng trưng bày (từ thời Tiền sử, dựng nước Hùng Vương, các triều đại phong kiến đến văn hóa Champa và Óc Eo). Nhóm ghi nhận cụ thể cấu trúc các cửa thông phòng (cửa nào dẫn sang phòng nào) để làm cơ sở xây dựng sơ đồ đồ thị cho thuật toán tìm đường đi ngắn nhất (Dijkstra) và định vị các biểu tượng mũi tên chuyển phòng. Đồng thời, nhóm ghi chú vị trí các tủ kính trưng bày cổ vật quý và khảo sát điều kiện ánh sáng thực tế (nhiều phòng ánh sáng tự nhiên yếu, sử dụng đèn rọi vàng chiếu thẳng vào tủ kính dễ gây lóa khi chụp ảnh).", bold_prefix="- Đợt 1 (Khảo sát hiện trạng không gian và thiết lập sơ đồ liên thông các phòng):")
    add_bullet_item(doc, " Nhóm sử dụng điện thoại thông minh thử nghiệm các thao tác quay video lia máy 360 độ và chụp ảnh ở chế độ góc siêu rộng (0,5x) tại một số gian phòng đại diện. Khi đưa dữ liệu vào thử nghiệm trên bộ công cụ xử lý ảnh (thư viện OpenCV), nhóm đã phát hiện và từng bước khắc phục các lỗi kỹ thuật phát sinh trong thực tế: hiện tượng lệch mí nối góc tường khi lia máy không đều tay, tình trạng dính bóng chân người chụp ở khu vực đáy sàn nhà, và ảnh bị chói lóa tại các điểm có đèn rọi trực tiếp. Kết quả thử nghiệm giúp nhóm hoàn thiện thuật toán làm mịn vùng sàn, cân bằng ánh sáng trong nhà và xây dựng quy chuẩn quay video quét phòng chuẩn xác (đứng quay chậm tại tâm phòng, lia đều tay 360 độ theo phương ngang).", bold_prefix="- Đợt 2 (Thử nghiệm kỹ thuật quay chụp bằng điện thoại và tối ưu thuật toán xử lý ảnh):")
    add_bullet_item(doc, " Tiến hành ghi hình dữ liệu quét toàn cảnh chuẩn cho toàn bộ 18 gian phòng trưng bày theo quy trình đã thử nghiệm thành công ở Đợt 2. Đồng thời, nhóm chụp ảnh chi tiết đa góc các cổ vật tiêu biểu của từng thời kỳ lịch sử (như tượng đá Champa, gốm men Lý - Trần, trang phục cung đình triều Nguyễn) phục vụ việc tái tạo mô hình vật thể ba chiều (định dạng 3D GLB). Nhóm cũng thu thập đầy đủ tư liệu lịch sử, bảng giới thiệu tại chỗ để làm nội dung cho hệ thống thuyết minh âm thanh đa ngôn ngữ và dữ liệu tri thức phục vụ trợ lý ảo thông minh.", bold_prefix="- Đợt 3 (Thu thập chính thức dữ liệu không gian 18 phòng và tư liệu cổ vật 3D):")
    add_bullet_item(doc, " Sau khi hoàn thiện và triển khai toàn bộ hệ thống lên máy chủ trực tuyến (Cloud VPS), nhóm mang thiết bị di động trực tiếp xuống bảo tàng để trải nghiệm và kiểm thử với tư cách người tham quan thực tế: kiểm tra tốc độ tải các không gian 360 độ và mô hình 3D trên kết nối mạng di động 4G tại khuôn viên; thử nghiệm luồng mua vé trực tuyến qua cổng thanh toán VietQR (PayOS) và sử dụng camera điện thoại quét mã QR soát vé tại cửa ra vào để kiểm tra độ nhạy và tính chính xác; đối chiếu sơ đồ bản đồ thu nhỏ (Mini-map) trên web với lộ trình đi lại thực tế của bảo tàng để tinh chỉnh các mũi tên chuyển phòng và hướng nhìn mặc định sao cho trực quan, khớp với thực địa.", bold_prefix="- Đợt 4 (Thực nghiệm hệ thống trên môi trường thực tế tại khuôn viên bảo tàng):")

# Placeholder removed according to rules

    add_heading_3(doc, "1.3.2. Bố cục tổng thể của báo cáo khóa luận")
    add_body_p(doc, "Nội dung cuốn báo cáo khóa luận tốt nghiệp được cấu trúc chặt chẽ thành 5 chương chính theo đúng tiến trình nghiên cứu và phát triển hoàn chỉnh của một hệ thống công nghệ thông tin, từ khảo sát thực tế, nghiên cứu lý thuyết, phân tích thiết kế cho đến hiện thực hóa phần mềm và đánh giá thực nghiệm:")
    add_bullet_item(doc, " Trình bày bối cảnh thực tế tại Bảo tàng Lịch sử TP.HCM, các thách thức về kinh phí thiết bị, mục tiêu nghiên cứu, phạm vi triển khai tại 18 gian phòng trưng bày và tiến trình 4 đợt tác nghiệp thực địa của nhóm sinh viên.", bold_prefix="- Chương 1: Tổng quan đề tài:")
    add_bullet_item(doc, " Nghiên cứu nguyên lý toán học của bài toán tạo ảnh toàn cảnh 360 độ từ video quay thông thường (nắn phẳng mặt trụ, trích xuất đặc trưng RootSIFT, ước lượng Homography lọc nhiễu qua RANSAC và hòa trộn đa băng tần Laplacian); khảo sát các phương pháp tái tạo mô hình hiện vật 3D (phương pháp nội suy hình học thể tích Heuristic CPU và mô hình khuếch tán AI TRELLIS GPU); cùng kiến trúc lưu trữ lai PostgreSQL - MongoDB - Redis và mô hình ngôn ngữ lớn Google Gemini.", bold_prefix="- Chương 2: Cơ sở lý thuyết và các công nghệ nền tảng:")
    add_bullet_item(doc, " Tổng hợp kết quả khảo sát thực tế cấu trúc không gian 18 gian phòng trưng bày liên hoàn; xác định các nhóm tác nhân (khách tham quan, ban quản trị, nhân viên soát vé); phân tích chi tiết các yêu cầu chức năng và phi chức năng; xây dựng sơ đồ ca sử dụng tổng quát (Use Case Diagram) và bảng phân loại nghiệp vụ.", bold_prefix="- Chương 3: Khảo sát hiện trạng và phân tích yêu cầu hệ thống:")
    add_bullet_item(doc, " Mô tả chi tiết kết quả hiện thực hóa 5 phân hệ chức năng cốt lõi dựa trên mã nguồn thực tế (Xưởng ghép ảnh 360°, Cổng tham quan Three.js & Mini-map Dijkstra, Trình tương tác Cổ vật 3D Đa Động cơ, Quản trị CMS Nhận diện thương hiệu, Đặt vé trực tuyến VietQR và Soát vé Camera QR di động); đồng thời công bố kết quả thực nghiệm qua 4 đợt tác nghiệp tại bảo tàng, bảng so sánh chuyên sâu giữa hai động cơ 3D và các số liệu đo lường hiệu năng FPS, RAM, thời gian tải trên mạng di động 4G.", bold_prefix="- Chương 4: Hiện thực hóa và đánh giá thực nghiệm:")
    add_bullet_item(doc, " Tổng kết toàn diện các kết quả khoa học và giá trị thực tiễn bảo tồn di sản chi phí 0 đồng của đề tài; thẳng thắn nhìn nhận những điểm còn hạn chế kỹ thuật và đề xuất các định hướng nâng cấp tiềm năng trong tương lai (WebXR trên kính thực tế ảo và công nghệ 3D Gaussian Splatting).", bold_prefix="- Chương 5: Kết luận và hướng phát triển:")

    # -------------------------------------------------------------------------
    # CHƯƠNG 2: CƠ SỞ LÝ THUYẾT VÀ CÁC PHƯƠNG PHÁP TIẾP CẬN KỸ THUẬT
    # -------------------------------------------------------------------------
    doc.add_page_break()
    add_heading_1(doc, "CHƯƠNG 2. CƠ SỞ LÝ THUYẾT VÀ CÁC PHƯƠNG PHÁP TIẾP CẬN KỸ THUẬT")

    add_body_p(doc, "Chương này trình bày toàn bộ cơ sở lý thuyết toán học, các thuật toán xử lý thị giác máy tính và ngăn xếp công nghệ nền tảng được nghiên cứu và ứng dụng trong đề tài. Nội dung tập trung vào hai bài toán kỹ thuật cốt lõi: phương pháp tạo lập không gian toàn cảnh thực tế ảo 360 độ từ dữ liệu video thông thường và phương pháp số hóa mô hình cổ vật ba chiều (3D) từ dữ liệu hình ảnh thực tế tại bảo tàng.")

    add_heading_2(doc, "2.1. Tổng quan về công nghệ không gian thực tế ảo 360° và mô hình hóa 3D")

    add_heading_3(doc, "2.1.1. Nguyên lý biểu diễn không gian toàn cảnh Equirectangular Projection")
    add_body_p(doc, "Không gian thực tế ảo 360 độ (Virtual Tour 360°) cho phép người xem quan sát toàn bộ môi trường xung quanh từ một điểm nhìn cố định theo góc nhìn hình cầu toàn diện: 360° theo phương ngang (kinh độ) và 180° theo phương đứng (vĩ độ) [1].")
    add_body_p(doc, "Để lưu trữ và xử lý một quả cầu không gian ba chiều dưới dạng tệp ảnh số hai chiều thông dụng (JPEG hoặc PNG), kỹ thuật đồ họa sử dụng phép chiếu hình học chữ nhật tương đương (Equirectangular Projection) [1]:")
    add_bullet_item(doc, " Ảnh toàn cảnh Equirectangular luôn có tỷ lệ khung hình cố định là 2:1 (chiều rộng gấp đúng 2 lần chiều cao, ví dụ: 4096 × 2048 điểm ảnh hoặc 2048 × 1024 điểm ảnh).", bold_prefix="- Tỷ lệ khung hình chuẩn:")
    add_bullet_item(doc, " Mọi điểm trên mặt cầu được xác định bởi hai góc cầu: góc kinh độ θ ∈ [-π, π] (hướng xoay ngang từ -180° đến +180°) và góc vĩ độ φ ∈ [-π/2, π/2] (hướng nhìn từ cực Nam -90° dưới chân lên cực Bắc +90° đỉnh đầu). Phép biến đổi chuyển từ tọa độ cầu (θ, φ) sang tọa độ điểm ảnh (x, y) trên bức ảnh có kích thước W × H được biểu diễn qua công thức toán học [1]:", bold_prefix="- Mối quan hệ tọa độ:")

    add_math_formula(doc, "x = ((θ + π) / 2π) · W")
    add_math_formula(doc, "y = ((π/2 - φ) / π) · H")

    add_body_p(doc, "Trong đó:")
    add_bullet_item(doc, " Trục ngang x trải dài tương ứng với toàn bộ 360° góc quay vòng quanh phòng. Khi người xem xoay hết cạnh phải của ảnh (x = W), màn hình sẽ tự động nối mượt sang cạnh trái (x = 0) tạo thành một chu trình khép kín liên tục.", bold_prefix="- Trục tọa độ ngang (x):")
    add_bullet_item(doc, " Trục dọc y biểu diễn góc nhìn từ sàn nhà lên trần nhà. Khu vực đường xích đạo (y = H/2) bảo toàn tỷ lệ hình học chuẩn xác nhất; trong khi hai khu vực đỉnh đầu (Zenith - cực Bắc) và đáy sàn (Nadir - cực Nam) bị kéo giãn ngang cực đại. Khi đưa vào môi trường không gian 3D của trình duyệt, bức ảnh chữ nhật này được dán ngược trở lại mặt trong của một khối cầu rỗng, giúp người xem có cảm giác như đang đứng tại tâm gian phòng và quan sát bốn bề không gian chân thực.", bold_prefix="- Trục tọa độ dọc (y):")

    # NGẮT TRANG ĐỂ BẢNG 2.1 BẮT ĐẦU TRỌN VẸN Ở ĐẦU TRANG MỚI, KHÔNG BỊ XÉ ĐÔI
    doc.add_page_break()

    add_heading_3(doc, "2.1.2. Khảo sát và so sánh các phương pháp tạo không gian toàn cảnh 360° hiện nay")
    add_body_p(doc, "Để tái tạo không gian phòng trưng bày của bảo tàng thành các chuyến tham quan ảo 360 độ, trong thực tế hiện nay tồn tại 3 hướng tiếp cận chính:")

    p_cap_tbl = doc.add_paragraph()
    format_paragraph(p_cap_tbl, space_before=4, space_after=3, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    p_cap_tbl.paragraph_format.keep_with_next = True
    set_run_font(p_cap_tbl.add_run("Bảng 2.1: Bảng so sánh toàn diện các phương pháp tạo lập không gian toàn cảnh 360°"), "Times New Roman", 12, bold=True, italic=True, color_rgb=COLOR_BLACK)

    # BẢNG 2.1 THOÁNG ĐÃNG, RỘNG RÃI (CHUẨN LƯỚI ACADEMIC GRID TABLE)
    tbl_2_1 = doc.add_table(rows=8, cols=4)
    tbl_2_1.style = 'Table Grid'
    tbl_2_1.alignment = WD_TABLE_ALIGNMENT.CENTER
    tbl_2_1.autofit = False
    set_table_borders(tbl_2_1, color="000000", sz="6")

    widths_2_1 = [Cm(3.2), Cm(4.2), Cm(4.2), Cm(4.4)]
    for r in tbl_2_1.rows:
        make_row_cant_split(r)
        for c_idx, w in enumerate(widths_2_1):
            r.cells[c_idx].width = w
            set_cell_margins(r.cells[c_idx], top=90, bottom=90, left=130, right=130)
            set_cell_vertical_alignment(r.cells[c_idx], "center")

    make_row_header(tbl_2_1.rows[0])

    headers_2_1 = [
        "Tiêu chí so sánh",
        "Phương pháp 1: Thuê thiết bị quét chuyên dụng (Matterport / LiDAR)",
        "Phương pháp 2: Chụp bằng máy ảnh 360° chuyên dụng (Insta360 / Theta)",
        "Phương pháp 3: Ghép tự động từ video điện thoại (Giải pháp đề tài)"
    ]
    for c_idx, h_text in enumerate(headers_2_1):
        cell = tbl_2_1.cell(0, c_idx)
        set_cell_background(cell, "EAECEF")
        p = cell.paragraphs[0]
        format_paragraph(p, space_before=4, space_after=4, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
        set_run_font(p.add_run(h_text), "Times New Roman", 10.5, bold=True, color_rgb=COLOR_BLACK)

    rows_data_2_1 = [
        ("Thiết bị sử dụng", "Máy quét chuyên dụng đắt tiền (từ 80 đến trên 150 triệu đồng).", "Máy ảnh 360 có 2 ống kính mắt cá đối lưng (từ 10 đến 25 triệu đồng).", "Điện thoại thông minh thông thường có sẵn camera (chế độ góc rộng 0,5x)."),
        ("Chi phí đầu tư", "Rất cao, phụ thuộc kinh phí thuê đơn vị dịch vụ bên ngoài thực hiện.", "Trung bình, bảo tàng phải cấp ngân sách mua sắm trang thiết bị riêng.", "0 đồng, tận dụng ngay thiết bị di động cá nhân của cán bộ, sinh viên."),
        ("Thời gian thu thập", "45 – 60 phút cho một gian phòng lớn, yêu cầu đặt chân máy nhiều vị trí.", "1 – 2 phút chụp nhanh tại tâm phòng.", "1 – 2 phút cầm tay lia máy quay chậm vòng tròn 360 độ tại tâm phòng."),
        ("Cơ chế xử lý", "Đẩy dữ liệu lên nền tảng đám mây đóng của nhà cung cấp (Matterport Cloud).", "Bộ vi xử lý bên trong máy ảnh tự động khâu 2 nửa bán cầu thành ảnh Equirectangular.", "Máy chủ nội bộ (stitching_worker) tự động trích xuất khung hình, nắn phẳng, so khớp SIFT và hòa trộn mí nối."),
        ("Tính tự chủ dữ liệu", "Bị phụ thuộc hoàn toàn: Phải trả phí duy trì lưu trữ hàng tháng; không tự chủ cập nhật.", "Chủ động lưu trữ ảnh gốc, nhưng cảm biến nhỏ dễ bị hạt nhiễu (noise) trong phòng tối.", "Tự chủ hoàn toàn 100%: Dữ liệu lưu trên máy chủ riêng của bảo tàng; tự do cập nhật khi đổi trưng bày."),
        ("Ưu điểm thực tế", "Độ chính xác không gian cực cao, dựng được cả sơ đồ đám mây điểm 3D.", "Thao tác chụp nhanh gọn, tải ảnh lên website là xem được ngay lập tức.", "Tối ưu hóa chi phí triệt để; thuật toán làm mịn sàn khử bóng chân người; linh hoạt triển khai."),
        ("Hạn chế thực tế", "Chi phí quá đắt đỏ so với ngân sách bảo tàng công lập; khó triển khai diện rộng.", "Vẫn tốn chi phí mua máy; chụp dưới đèn rọi vàng của bảo tàng dễ bị lóa sáng.", "Đòi hỏi người quay lia máy đều tay; thời gian máy chủ xử lý ảnh mất 2 đến 4 phút cho mỗi phòng.")
    ]

    for r_idx, row_values in enumerate(rows_data_2_1):
        for c_idx, val in enumerate(row_values):
            cell = tbl_2_1.cell(r_idx + 1, c_idx)
            p = cell.paragraphs[0]
            align = WD_ALIGN_PARAGRAPH.CENTER if c_idx == 0 else WD_ALIGN_PARAGRAPH.JUSTIFY
            format_paragraph(p, space_before=3, space_after=3, line_spacing=1.15, align=align, first_indent=0.0, left_indent=0.0)
            is_bold = (c_idx == 0)
            set_run_font(p.add_run(val), "Times New Roman", 10.0, bold=is_bold, color_rgb=COLOR_BLACK)

    add_body_p(doc, "Nhận xét: Xuất phát từ thực tế kinh phí hạn hẹp của các bảo tàng di sản công lập tại Việt Nam, đề tài chọn Phương pháp 3 làm hướng tiếp cận kỹ thuật nghiên cứu mũi nhọn, đồng thời vẫn hỗ trợ phân hệ cho phép tải trực tiếp ảnh 360 có sẵn (Phương pháp 2) để ban quản trị bảo tàng có thể linh hoạt sử dụng khi có sẵn nguồn tư liệu chất lượng cao.", space_after=6)

    add_heading_2(doc, "2.2. Cơ sở toán học và thuật toán ghép ảnh toàn cảnh từ video quét phòng")
    add_body_p(doc, "Khi người dùng quay một đoạn video lia máy vòng tròn 360 độ bằng điện thoại thông thường, dữ liệu đầu vào là một chuỗi hàng trăm khung hình kế tiếp nhau. Mô đun xử lý ảnh stitching_worker trong dự án thực hiện chuỗi thuật toán xử lý theo 4 bước liên hoàn:")

    add_heading_3(doc, "2.2.1. Phép chiếu mặt trụ (Cylindrical Warping) nắn phẳng ảnh góc rộng")
    add_body_p(doc, "Trong thực tế, khi lia máy ảnh quay quanh một trục cố định, các khung hình chụp được là các mặt phẳng chiếu phẳng (planar projection) tiếp xúc với đường tròn xoay. Nếu ghép trực tiếp các ảnh phẳng này lại với nhau, các vật thể ở rìa ảnh sẽ bị biến dạng phối cảnh, các đường thẳng thực tế (như góc tường, mép tủ kính) bị cong gãy và mí nối giữa hai ảnh kề nhau bị lệch nghiêm trọng [1].")
    add_body_p(doc, "Để giải quyết hiện tượng này, bước đầu tiên là phải chuyển đổi từng khung hình phẳng sang bề mặt của một hình trụ tưởng tượng bao quanh tâm quay của máy ảnh [1].")
    add_body_p(doc, "Giả sử máy ảnh có tiêu cự f (tính theo đơn vị pixel), tâm ảnh có tọa độ (xc, yc). Với mỗi điểm ảnh (x, y) trên ảnh gốc phẳng, tọa độ tương ứng (x', y') sau khi uốn cong lên mặt trụ được tính toán thông qua phép biến đổi lượng giác [1]:")

    add_math_formula(doc, "x' = f · arctan((x - xc) / f) + xc")
    add_math_formula(doc, "y' = f · (y - yc) / √((x - xc)² + f²) + yc")

    add_body_p(doc, "Ý nghĩa kỹ thuật: Phép chiếu mặt trụ làm cho mọi góc xoay ngang thuần túy của máy ảnh trở thành các phép tịnh tiến trượt ngang đơn giản trên bề mặt hình trụ. Điều này giúp các mép tường đứng bảo toàn góc 90° vuông vức và giảm thiểu tối đa độ méo phối cảnh khi lia máy.")

    add_heading_3(doc, "2.2.2. Thuật toán trích xuất đặc trưng SIFT và ước lượng ma trận chuyển đổi Homography với RANSAC")
    add_body_p(doc, "Sau khi đã nắn cong các khung hình lên mặt trụ, hệ thống cần tìm ra mối quan hệ liên kết không gian (vùng chồng lấn) giữa hai khung hình liên tiếp:")
    add_bullet_item(doc, " Thuật toán SIFT tìm kiếm các điểm đặc trưng nổi bật (như góc cạnh cổ vật, hoa văn tủ trưng bày) thông qua không gian tỷ lệ bằng hàm sai phân Gauss. Tại mỗi điểm nhận diện được, thuật toán trích xuất một véc-tơ mô tả gồm 128 chiều có tính chất bất biến trước các phép quay, co giãn góc nhìn và thay đổi độ chiếu sáng [2]. Trong dự án, nhóm áp dụng biến thể nâng cao RootSIFT để tăng cường độ chính xác khi so khớp giữa các góc phòng có ánh đèn rọi phản quang trên tủ kính [3].", bold_prefix="1. Trích xuất đặc trưng bất biến SIFT và RootSIFT:")
    add_bullet_item(doc, " Quá trình so khớp véc-tơ giữa hai ảnh kề nhau luôn tồn tại các cặp điểm bị lệch do ánh sáng phản chiếu hoặc người đi lại. Thuật toán RANSAC được áp dụng để lọc sạch các điểm sai này: thông qua nhiều vòng lặp thử nghiệm ngẫu nhiên, thuật toán ước lượng ma trận biến đổi phối cảnh Homography kích thước 3 × 3 tối ưu nhất, đồng thời loại bỏ toàn bộ các điểm sai lệch để đảm bảo hai khung hình được ráp nối chuẩn xác [4].", bold_prefix="2. Khử điểm sai và ước lượng ma trận phối cảnh với RANSAC:")

    add_heading_3(doc, "2.2.3. Kỹ thuật hòa trộn đa băng tần (Multi-band Blending) và xử lý vùng đáy sàn (Nadir)")
    add_body_p(doc, "Khi các khung hình đã được căn chỉnh tọa độ chính xác, việc ghép chồng trực tiếp mí ảnh sẽ tạo ra đường lằn nối rõ rệt do độ phơi sáng tự động của điện thoại thay đổi liên tục giữa các góc phòng sáng và tối.")
    add_body_p(doc, "Đề tài áp dụng kỹ thuật Hòa trộn đa băng tần trên tháp Laplacian (Multi-band Spline Blending) [5]: phân rã mỗi bức ảnh thành tháp Gauss (chứa thông tin độ sáng tần số thấp) và tháp Laplacian (chứa các chi tiết cạnh sắc tần số cao). Ở dải tần số thấp, thuật toán sử dụng dải chuyển tiếp rộng để làm mịn sự chênh lệch ánh sáng tổng thể một cách tự nhiên; ở dải tần số cao, thuật toán dùng dải chuyển tiếp hẹp để giữ nguyên độ sắc nét của hoa văn, chi tiết cổ vật mà không gây hiện tượng bóng ma (ghosting).")
    add_body_p(doc, "Xử lý vùng đáy sàn nhà (Nadir Patch): Khu vực chân người chụp ảnh ở cực Nam thường để lại bóng đen hoặc chân người. Hệ thống tự động tạo mặt nạ đắp vá (inpaint / blending patch) dựa trên vân gạch sàn xung quanh để tạo nên một bức ảnh toàn cảnh 360° hoàn chỉnh, khép kín và thẩm mỹ.")

    add_heading_2(doc, "2.3. Các phương pháp tái tạo mô hình Cổ vật 3D")
    add_body_p(doc, "Để đưa cổ vật quý trong bảo tàng lên không gian số phục vụ công chúng tương tác xoay phóng đa chiều, đề tài nghiên cứu hai phương pháp tái tạo hình học ba chiều bám sát mã nguồn thực tế:")

    add_heading_3(doc, "2.3.1. Phương pháp tái tạo mô hình 3D từ một ảnh duy nhất (Single-view Reconstruction)")
    add_body_p(doc, "Đây là phương pháp cực kỳ quan trọng đối với các cổ vật quý tại Bảo tàng Lịch sử TP.HCM vì phần lớn hiện vật (như tượng đá, đồ gốm, trang phục cổ) được đặt sát vách tường hoặc trong các tủ kính góc hẹp, người chụp không thể đi ra phía sau để chụp đủ các góc.")
    add_body_p(doc, "Quy trình thực hiện của người dùng: Người dùng chỉ cần chụp duy nhất 1 tấm ảnh mặt trước của cổ vật bằng điện thoại với độ rõ nét cao, đảm bảo bao quát trọn vẹn đường viền hiện vật, sau đó tải lên hệ thống Studio.")
    add_body_p(doc, "Cơ chế tạo lập mô hình 3D từ một ảnh đơn trong hệ thống được tiến hành liên hoàn qua 4 công đoạn kỹ thuật chính:")
    add_bullet_item(doc, " Áp dụng mạng nơ-ron tích chập U2-Net [6] nhận diện chính xác đường biên bao quanh cổ vật (Silhouette), bóc tách hiện vật ra khỏi phông nền và loại bỏ hoàn toàn ánh đèn phản chiếu trên tủ kính phía sau.", bold_prefix="1. Bóc tách phông nền tự động:")
    add_bullet_item(doc, " Thay vì ép phẳng hiện vật thành tấm bìa mỏng hai chiều, thuật toán tính toán trường khoảng cách từ đường biên vào trục tâm của cổ vật. Chiều sâu vòm cầu được chuẩn hóa tự động theo tỷ lệ thực tế của hiện vật (đạt từ 85% đến 100% chiều rộng). Thuật toán áp dụng hàm điều hòa liên tục để khử hiện tượng gờ bậc thang, giúp các chi tiết phức tạp như quai bình gốm hay chân vạc không bị phình to bất thường.", bold_prefix="2. Nội suy thể tích điều hòa liên tục:")
    add_bullet_item(doc, " Hệ thống thực hiện mở rộng mép viền ảnh 18 chu kỳ để khử triệt để viền đen; đồng thời tính toán độ dốc bề mặt để sinh ra bản đồ pháp tuyến (Normal Map), giúp hoa văn chạm khắc cổ xưa hiển thị sắc nét và gồ ghề chân thực dưới ánh sáng phản chiếu trong không gian 3D.", bold_prefix="3. Trải giãn vân bề mặt và sinh bản đồ pháp tuyến:")
    add_bullet_item(doc, " Tạo lưới đa giác khép kín đạt chuẩn định dạng tệp 3D nhị phân .GLB với dung lượng tối ưu nhẹ (khoảng 2 đến 5 MB) để hiển thị mượt mà trên điện thoại. Đồng thời, hệ thống hỗ trợ kết nối dịch vụ trí tuệ nhân tạo đám mây (Trellis) trên môi trường máy chủ chuyên dụng để suy diễn thể tích mặt sau tự nhiên cho các cổ vật có hình khối phức tạp [7].", bold_prefix="4. Xuất tệp mô hình 3D chuẩn hóa (.GLB):")
    add_body_p(doc, "Đánh giá Ưu & Nhược điểm: Ưu điểm là thao tác siêu nhanh, chỉ cần 1 ảnh duy nhất, thời gian tạo khối tức thì trong vài giây, giải quyết triệt để rào cản tủ kính sát tường của bảo tàng. Nhược điểm là hình khối mặt sau là hình học suy diễn đối xứng thể tích dựa trên mặt trước, không phản ánh được hoa văn đặc thù mặt sau nếu cổ vật có thiết kế bất đối xứng.")

    add_heading_3(doc, "2.3.2. Phương pháp quét hình học đa góc truyền thống (Multi-view Photogrammetry)")
    add_body_p(doc, "Áp dụng cho các cổ vật đặt tại bàn trưng bày mở hoặc tủ kính 4 mặt thông thoáng ở giữa phòng (như đỉnh đồng, tượng tròn Champa), cho phép người chụp di chuyển xung quanh 360°.")
    add_body_p(doc, "Quy trình thực hiện của người dùng: Người thực hiện cầm điện thoại di chuyển chậm quanh cổ vật theo 3 vòng quỹ đạo (góc chụp ngang thân, góc chụp chúc từ trên xuống 45°, góc chụp thấp từ dưới lên), chụp một bộ ảnh từ 30 đến 60 tấm có độ gối mí hình ảnh liên tiếp nhau đạt từ 60% đến 80%.")
    add_body_p(doc, "Quy trình tái tạo mô hình 3D đa góc được thực hiện tự động qua 3 giai đoạn tính toán chính:")
    add_bullet_item(doc, " Trích xuất đặc trưng SIFT trên toàn bộ các bức ảnh và tiến hành so khớp chéo. Thuật toán điều chỉnh chùm tia (Bundle Adjustment) được sử dụng để đồng thời ước lượng thông số camera và góc quay không gian ba chiều của từng bức ảnh, xuất ra đám mây điểm thưa thể hiện khung xương không gian của cổ vật trong mô hình COLMAP SfM [8].", bold_prefix="1. Định vị máy ảnh và tái tạo khung điểm thưa:")
    add_bullet_item(doc, " Thuật toán thị giác đa chiều (Multi-View Stereo) phân tích bản đồ chiều sâu trên từng bức ảnh, phóng chiếu các điểm tương đồng để tạo thành đám mây điểm dày đặc gồm hàng trăm ngàn điểm ảnh có tọa độ không gian và màu sắc chân thực dựa trên thư viện OpenMVS [9]. Tiếp theo, hệ thống kết nối các điểm đám mây thành bề mặt lưới gồm các mặt tam giác khép kín và tiến hành lọc mịn bề mặt.", bold_prefix="2. Làm dày đám mây điểm và dựng lưới đa giác:")
    add_bullet_item(doc, " Chiếu ngược các bức ảnh chụp sắc nét ban đầu lên từng mặt lưới tam giác tương ứng, tính toán cân bằng độ sáng cục bộ để tạo ra tệp kết cấu vân ảnh chất lượng cao. Hệ thống tiến hành tối ưu hóa giảm bớt số lượng đa giác thừa và đóng gói thành tệp nhị phân .GLB tối ưu.", bold_prefix="3. Áp vân bề mặt ảnh thật và đóng gói mô hình:")
    add_body_p(doc, "Đánh giá Ưu & Nhược điểm: Ưu điểm là độ chính xác hình học cực cao, tái tạo trung thực 100% mọi vết nứt, hoa văn và màu sắc thực tế ở cả mặt trước lẫn mặt sau hiện vật. Nhược điểm là đòi hỏi không gian chụp phải rộng rãi, đi vòng được 4 phía; quy trình tính toán xử lý hình học đa góc tiêu tốn nhiều thời gian (từ 15 đến 30 phút trên máy tính) và đòi hỏi cấu hình phần cứng mạnh.")

    add_heading_2(doc, "2.4. Ngăn xếp công nghệ phát triển hệ thống trên nền tảng Web")

    add_heading_3(doc, "2.4.1. Phân hệ kết xuất đồ họa 3D trực tiếp trên trình duyệt (Three.js và React)")
    add_body_p(doc, "Để khách tham quan có thể trải nghiệm chuyến tham quan thực tế ảo mượt mà trên máy tính và điện thoại mà không cần cài đặt thêm bất kỳ phần mềm hay tiện ích mở rộng nào, nhóm lựa chọn thư viện đồ họa Three.js [10] chạy trên nền tảng WebGL 2.0 chuẩn mở của trình duyệt [11].")
    add_body_p(doc, "Thư viện Three.js đóng vai trò là cầu nối giúp trình duyệt khai thác trực tiếp sức mạnh xử lý của chip đồ họa (GPU). Trong dự án thực tế, công nghệ này được nhóm ứng dụng cụ thể vào 4 chức năng cốt lõi sau:")
    add_bullet_item(doc, " Hệ thống khởi tạo một khối cầu không gian ảo, sau đó dán bức ảnh toàn cảnh 360 độ vào mặt bên trong của quả cầu. Điểm nhìn của camera được đặt ngay tại tâm hình cầu. Khi người dùng kéo chuột trên máy tính hoặc vuốt ngón tay trên màn hình điện thoại, góc quay của camera sẽ thay đổi tương ứng, giúp người xem có cảm giác như đang đứng giữa gian phòng bảo tàng và xoay nhìn tự do bốn hướng.", bold_prefix="- Tái tạo không gian phòng 360 độ:")
    add_bullet_item(doc, " Hệ thống đọc tệp dữ liệu ba chiều của cổ vật định dạng nhị phân tiêu chuẩn quốc tế glTF/GLB [12], cho phép người tham quan tự do xoay lật các góc, phóng to để quan sát tỉ mỉ từng đường nét hoa văn chạm khắc hoặc thu nhỏ để ngắm nhìn hình khối tổng thể của hiện vật.", bold_prefix="- Hiển thị và tương tác mô hình cổ vật 3D:")
    add_bullet_item(doc, " Khi người quản trị nhấp chuột vào một vị trí trên cửa phòng, hệ thống tự động tính toán tia chiếu từ màn hình vào mặt cầu để xác định chính xác tọa độ góc quay. Điểm này sau đó được gắn biểu tượng mũi tên dẫn đường, cho phép khách tham quan nhấp vào để bước sang gian phòng kế tiếp.", bold_prefix="- Định vị và kích hoạt điểm chuyển phòng (Hotspots):")
    add_bullet_item(doc, " Vì các thiết bị di động thường có dung lượng bộ nhớ RAM giới hạn, mã nguồn phía máy trạm chủ động giải phóng toàn bộ dữ liệu hình ảnh và khối hình học của phòng cũ ngay khi người dùng chuyển sang phòng mới. Cơ chế dọn dẹp bộ nhớ này giúp trình duyệt luôn hoạt động ổn định, mượt mà và không bao giờ bị hiện tượng tràn RAM gây văng ứng dụng.", bold_prefix="- Tối ưu hóa bộ nhớ chống đứng máy trên điện thoại:")

    add_heading_3(doc, "2.4.2. Phân hệ máy chủ dịch vụ và kiến trúc cơ sở dữ liệu lai (Node.js, PostgreSQL, MongoDB và Redis)")
    add_body_p(doc, "Bám sát kiến trúc mã nguồn thực tế tại thư mục backend/src/, hệ thống máy chủ được xây dựng theo mô hình phân tán, kết hợp giữa cơ sở dữ liệu quan hệ và cơ sở dữ liệu tài liệu để tối ưu hóa đồng thời hiệu năng truy vấn và an toàn dữ liệu:")
    add_bullet_item(doc, " Đóng vai trò là đầu mối tiếp nhận, điều phối và xác thực toàn bộ yêu cầu người dùng qua giao diện RESTful API. Hệ thống phân tách thành các bộ định tuyến chuyên trách: quản lý 18 gian phòng (rooms.ts), cổ vật di sản (artifacts.ts), đặt vé và soát vé QR (tickets.ts), thanh toán PayOS VietQR (payos.ts), sơ đồ mặt bằng (floorPlan.ts), quản trị giao diện CMS (SystemBranding.ts) và dịch vụ AI (ai.ts).", bold_prefix="- Máy chủ dịch vụ Node.js Express (server.ts):")
    add_bullet_item(doc, " Đảm nhận vai trò Primary Relational Database [13] lưu trữ các thực thể nghiệp vụ đòi hỏi tính nhất quán tuyệt đối, ràng buộc khóa ngoại và giao dịch ACID: bảng người dùng (users), vai trò phân quyền (roles theo RBAC), loại vé và khung giờ (ticket_types, ticket_time_slots), đơn hàng thanh toán (orders), vé tham quan điện tử (tickets với mã chuẩn BTLS-YYYY-XXXXXXXX, trạng thái vé và mốc thời gian soát vé used_at) cùng nhật ký kiểm toán (audit_logs).", bold_prefix="- Cơ sở dữ liệu quan hệ PostgreSQL (db/postgres.ts):")
    add_bullet_item(doc, " Đóng vai trò Document & Spatial Store lưu trữ dữ liệu không gian ba chiều: danh mục 18 phòng trưng bày kèm ma trận tọa độ Hotspot 3D, dữ liệu cổ vật (ArtifactModel) gắn tệp .GLB, sơ đồ mặt bằng liên hoàn (FloorPlanMap) và từ điển đa ngôn ngữ (Language).", bold_prefix="- Cơ sở dữ liệu tài liệu MongoDB (db/mongodb.ts):")
    add_bullet_item(doc, " Mô đun chuyên trách đồng bộ dữ liệu hai chiều giữa PostgreSQL và MongoDB: mọi biến động quan trọng tại PostgreSQL được phản chiếu sang MongoDB dưới dạng tài liệu nhúng để tăng tốc độ đọc của client; ngược lại các điều chỉnh tọa độ Hotspot từ Studio được cập nhật vào MongoDB và đồng bộ khóa ngoại trong PostgreSQL.", bold_prefix="- Động cơ đồng bộ dữ liệu SyncEngine (db/syncEngine.ts):")
    add_bullet_item(doc, " Ứng dụng hệ thống lưu trữ trên bộ nhớ RAM Redis [14] để lưu tạm thời danh mục 18 phòng phản hồi client tức thì (< 15ms), điều phối hàng đợi tác vụ ghép ảnh ngầm (stitchQueue), và phát tán sự kiện thời gian thực qua Server-Sent Events (SSE) giúp cập nhật trạng thái vé và CMS trang chủ ngay lập tức mà không cần người dùng tải lại trang.", bold_prefix="- Bộ nhớ đệm Redis & Kênh đồng bộ thời gian thực (redis.ts & realtimeSync.ts):")
    add_bullet_item(doc, " Tích hợp mô hình ngôn ngữ lớn Google Gemini API [15] (gemini-2.5-flash). Dịch vụ tự động nạp thông tin lịch sử của gian phòng và hiện vật mà khách đang tham quan vào ngữ cảnh (Context Injection / Lightweight RAG), đồng thời tích hợp bộ đệm kiểm soát tần suất Rate Limiting (giãn cách tối thiểu 3 giây, tối đa 15 câu/phút) để ngăn chặn tấn công quá tải.", bold_prefix="- Dịch vụ Trí tuệ Nhân tạo Google Gemini (services/aiService.ts):")


    # ==========================================
    # CHƯƠNG 3: KHẢO SÁT HIỆN TRẠNG VÀ PHÂN TÍCH YÊU CẦU HỆ THỐNG
    # ==========================================
    doc.add_page_break()

    doc.add_page_break()
    add_heading_1(doc, "CHƯƠNG 3. KHẢO SÁT HIỆN TRẠNG VÀ PHÂN TÍCH YÊU CẦU HỆ THỐNG")
    add_body_p(doc, "Chương này trình bày toàn bộ kết quả khảo sát thực địa tại Bảo tàng Lịch sử TP. Hồ Chí Minh qua 4 đợt tác nghiệp của nhóm sinh viên; phân loại các nhóm tác nhân tham gia vào hệ thống; và phân tích chi tiết các yêu cầu chức năng, yêu cầu phi chức năng cùng mô hình ca sử dụng tổng quát của hệ thống phần mềm.")

    add_heading_2(doc, "3.1. Khảo sát hiện trạng không gian và quy trình nghiệp vụ tại bảo tàng")

    add_heading_3(doc, "3.1.1. Hiện trạng kiến trúc và không gian trưng bày 18 gian phòng")
    add_body_p(doc, "Bảo tàng Lịch sử TP. Hồ Chí Minh (tọa lạc tại số 2 đường Nguyễn Bỉnh Khiêm, phường Bến Nghé, Quận 1) là một trong những công trình di sản kiến trúc tiêu biểu của thành phố, sở hữu khuôn viên rộng lớn và hệ thống 18 gian phòng trưng bày liên hoàn:")
    add_bullet_item(doc, " Các gian phòng được xây dựng kết nối tiếp nối nhau tạo thành một chu trình khép kín bao quanh sân trong. Khách tham quan di chuyển tuần tự qua các thời kỳ lịch sử dân tộc: từ Thời Tiền sử, Dựng nước Hùng Vương, Thời kỳ đấu tranh giành độc lập (thế kỷ I – X), các triều đại phong kiến độc lập (Ngô – Đinh – Tiền Lê, Lý, Trần, Hậu Lê, Tây Sơn, Triều Nguyễn) cho đến các phòng chuyên đề đặc biệt như Văn hóa Champa, Văn hóa Óc Eo – Phù Nam và Nghệ thuật Phật giáo Châu Á.", bold_prefix="- Cấu trúc mặt bằng liên hoàn:")
    add_bullet_item(doc, " Do diện tích bảo tàng lớn, các gian phòng có nhiều cửa thông phòng đối xứng nhau và các hành lang dài, khách tham quan trực tiếp (đặc biệt là khách quốc tế và các đoàn học sinh) thường gặp khó khăn trong việc định hình lộ trình tham quan, dễ bỏ sót các gian phòng trưng bày ở góc khuất hoặc đi ngược thứ tự tiến trình lịch sử.", bold_prefix="- Vấn đề điều hướng thực tế:")
    add_bullet_item(doc, " Việc xây dựng một sơ đồ bản đồ thu nhỏ (Mini-map) có khả năng định vị vị trí phòng hiện tại và chỉ dẫn đường đi ngắn nhất giữa hai phòng bất kỳ là một yêu cầu cấp thiết để nâng cao trải nghiệm tham quan từ xa lẫn hỗ trợ khách đến bảo tàng.", bold_prefix="- Nhu cầu số hóa không gian:")

    # Sơ đồ mặt bằng 18 phòng
    add_centered_image(doc, "baocaokhoaluan/assets/hinh_3_1_so_do_mat_bang_18_phong.png",
                       "Hình 3.1: Sơ đồ mặt bằng liên hoàn 18 gian phòng trưng bày tại Bảo tàng Lịch sử TP.HCM", width_cm=15.0)

    add_heading_3(doc, "3.1.2. Hiện trạng bảo quản cổ vật và hạn chế của không gian trưng bày vật lý")
    add_body_p(doc, "Bảo tàng hiện đang lưu giữ và bảo tồn hơn 40.000 hiện vật lịch sử quý giá, trong đó có nhiều bảo vật quốc gia phản ánh diện mạo văn hóa đa dạng của vùng đất Nam Bộ và lịch sử dân tộc [16]:")
    add_bullet_item(doc, " Để đảm bảo an toàn tuyệt đối trước các tác động của môi trường và con người, hầu hết các cổ vật quý (như tượng đá thế kỷ VII, đồ gốm men lam, vũ khí kim loại cổ) đều được niêm phong nghiêm ngặt trong các tủ kính chuyên dụng hoặc được đặt sát vách tường. Khách tham quan chỉ có thể quan sát hiện vật từ một góc nhìn duy nhất ở mặt trước, không thể đi vòng ra phía sau hoặc ngắm nhìn cận cảnh các đường nét hoa văn chạm khắc tinh xảo.", bold_prefix="- Hạn chế của tủ kính bảo vệ:")
    add_bullet_item(doc, " Quy định an ninh bảo tàng tuyệt đối cấm người xem chạm tay vào hiện vật. Điều này tạo ra một rào cản vô hình đối với việc tiếp cận thông tin chuyên sâu của học sinh, sinh viên và các nhà nghiên cứu lịch sử.", bold_prefix="- Rào cản về trải nghiệm tương tác:")
    add_bullet_item(doc, " Không gian trưng bày trong bảo tàng sử dụng hệ thống đèn rọi vàng cục bộ để tôn vinh hiện vật, đồng thời mặt kính tủ trưng bày tạo ra nhiều vệt phản quang. Đây là thách thức kỹ thuật lớn đòi hỏi quy trình thu thập dữ liệu ảnh và tái tạo mô hình 3D phải có khả năng xử lý bóc tách phông nền và bù trừ ánh sáng hiệu quả.", bold_prefix="- Đặc thù chiếu sáng:")

    add_heading_3(doc, "3.1.3. Khảo sát quy trình nghiệp vụ bán vé và kiểm soát ra vào")
    add_body_p(doc, "Quy trình phục vụ khách tham quan tại cổng bảo tàng hiện nay chủ yếu dựa trên phương thức truyền thống:")
    add_bullet_item(doc, " Khách tham quan phải xếp hàng mua vé giấy trực tiếp tại quầy vé ngoài cổng. Vào các dịp lễ, cuối tuần hoặc khi có các đoàn học sinh tham quan ngoại khóa, khu vực quầy vé thường xuyên xảy ra tình trạng ùn tắc cục bộ.", bold_prefix="- Bán vé giấy tại quầy:")
    add_bullet_item(doc, " Nhân viên bảo vệ tại cửa kiểm tra vé bằng mắt thường và xé cuống vé giấy bằng tay. Phương thức này vừa tốn chi phí in ấn vé giấy hàng năm, vừa không cung cấp được số liệu thống kê lượt khách theo thời gian thực cho ban giám đốc bảo tàng.", bold_prefix="- Soát vé thủ công:")
    add_bullet_item(doc, " Cần xây dựng một cổng đặt mua vé trực tuyến tích hợp thanh toán mã VietQR tự động, phát hành vé điện tử có mã phản hồi nhanh (QR Code) gửi về hộp thư điện tử của khách, kết hợp ứng dụng quét mã QR bằng camera điện thoại của nhân viên soát vé tại cửa ra vào để hiện đại hóa toàn diện khâu đón tiếp.", bold_prefix="- Nhu cầu tích hợp cổng thanh toán số:")

    add_heading_2(doc, "3.2. Xác định các nhóm tác nhân người dùng (Actors)")
    add_body_p(doc, "Hệ thống được thiết kế phục vụ 3 nhóm tác nhân chính tham gia vào các hoạt động nghiệp vụ:")
    add_bullet_item(doc, " Là người dùng đại chúng truy cập vào hệ thống website thông qua máy tính hoặc điện thoại thông minh có kết nối Internet mà không bắt buộc phải đăng ký tài khoản. Nhu cầu chính gồm: trải nghiệm chuyến tham quan thực tế ảo 360 độ qua 18 phòng, bước qua các cửa phòng mượt mà, sử dụng bản đồ Mini-map để tìm đường đi ngắn nhất, xoay lật ngắm cổ vật 3D, nghe giọng đọc thuyết minh đa ngôn ngữ, trò chuyện hỏi đáp lịch sử với Trợ lý ảo AI, và đặt mua vé tham quan trực tuyến qua mã VietQR.", bold_prefix="1. Khách tham quan (Visitor):")
    add_bullet_item(doc, " Là cán bộ phụ trách nội dung số hóa và quản lý không gian của Bảo tàng Lịch sử TP.HCM, được cấp tài khoản định danh bảo mật riêng. Nhu cầu chính gồm: đăng nhập quản trị an toàn; tải lên video quay phòng để hệ thống tự động xử lý ghép ảnh toàn cảnh 360 độ; sử dụng Studio đồ họa trực quan để cắm và điều chỉnh tọa độ các mũi tên chuyển phòng; quản trị danh mục hiện vật cổ vật 3D; cấu hình nội dung thuyết minh và quản lý danh sách đơn hàng mua vé.", bold_prefix="2. Ban quản trị bảo tàng (Administrator):")
    add_bullet_item(doc, " Là cán bộ trực tại cửa ra vào của bảo tàng, sử dụng thiết bị di động có camera và trình duyệt web để thực hiện nhiệm vụ. Nhu cầu chính gồm: truy cập phân hệ soát vé an toàn, sử dụng camera điện thoại quét mã QR trên vé điện tử của khách tham quan, nhận phản hồi tức thì về tính hợp lệ của vé để điều phối khách vào cổng nhanh chóng.", bold_prefix="3. Nhân viên soát vé (Ticket Inspector):")

    add_heading_2(doc, "3.3. Phân tích chi tiết các yêu cầu chức năng của hệ thống")
    add_body_p(doc, "Bám sát mã nguồn thực tế của dự án, hệ thống được cấu thành từ 3 phân hệ chức năng nghiệp vụ trọng tâm:")

    add_heading_3(doc, "3.3.1. Phân hệ dành cho Khách tham quan (Visitor Portal)")
    add_body_p(doc, "Phân hệ này cung cấp giao diện tương tác trực quan trên nền trình duyệt web, bao gồm 6 khối chức năng chính:")
    add_bullet_item(doc, " Trình diễn không gian phòng trưng bày dưới dạng khối cầu ba chiều toàn cảnh. Người dùng dùng chuột kéo rê trên máy tính hoặc vuốt ngón tay trên điện thoại để xoay nhìn tự do bốn hướng xung quanh, nhìn lên trần nhà và nhìn xuống sàn nhà với độ sắc nét cao. Hiển thị các điểm tương tác chuyển phòng (Hotspots) dưới dạng biểu tượng mũi tên dẫn đường 3D gắn cố định tại vị trí các cửa đi. Khi người dùng nhấp vào mũi tên, hệ thống thực hiện hiệu ứng chuyển cảnh mềm mại sang gian phòng kế tiếp.", bold_prefix="1. Tham quan thực tế ảo 360 độ (Virtual Tour 360°):")
    add_bullet_item(doc, " Hiển thị sơ đồ thu nhỏ tổng thể mặt bằng 18 gian phòng tại góc màn hình. Định vị phòng hiện tại của người tham quan bằng dấu chấm nổi bật kèm hình nón biểu thị hướng xoay của camera (Radar View). Tích hợp thuật toán tìm đường ngắn nhất Dijkstra [17]: khách tham quan có thể chọn một phòng đích đến bất kỳ, hệ thống sẽ tự động tính toán lộ trình tối ưu và vẽ đường viền nối liền các phòng cần đi qua, giúp khách không bao giờ bị lạc trong không gian rộng lớn của bảo tàng.", bold_prefix="2. Bản đồ dẫn đường thông minh (Mini-map & Dijkstra):")
    add_bullet_item(doc, " Khi nhấp vào các điểm đánh dấu hiện vật trong phòng hoặc chọn từ danh mục di sản, giao diện mở ra một khung tương tác ba chiều độc lập. Khách tham quan có thể dùng tay xoay tròn 360 độ hiện vật, phóng to tối đa để chiêm ngưỡng chi tiết hoa văn chạm khắc, hoặc thu nhỏ để quan sát tỷ lệ hình học tổng thể. Cung cấp bảng thông tin lịch sử chi tiết: tên cổ vật, niên đại, thời kỳ văn hóa, chất liệu, kích thước thực tế và ý nghĩa văn hóa khảo cổ học.", bold_prefix="3. Số hóa và tương tác Cổ vật 3D (3D Artifact Viewer):")
    add_bullet_item(doc, " Hỗ trợ chuyển đổi nhanh chóng giữa hai ngôn ngữ: Tiếng Việt và Tiếng Anh. Toàn bộ tiêu đề, nhãn nút bấm và văn bản thuyết minh tự động dịch chuyển đồng bộ. Tích hợp trình phát âm thanh thuyết minh tự động. Khi khách bước vào phòng mới, hệ thống tự động tải tệp âm thanh giọng đọc truyền cảm đã được biên dịch sẵn, cho phép người dùng tạm dừng, phát tiếp hoặc điều chỉnh âm lượng theo nhu cầu.", bold_prefix="4. Thuyết minh âm thanh đa ngôn ngữ (Audio Guide):")
    add_bullet_item(doc, " Tích hợp khung cửa sổ trò chuyện thông minh trực tiếp trên màn hình tham quan. Khách tham quan có thể đặt các câu hỏi tự nhiên về lịch sử, triều đại, ý nghĩa các bảo vật đang trưng bày trong gian phòng hiện tại. Trợ lý AI phân tích ngữ cảnh phòng tham quan và phản hồi bằng thông tin ngắn gọn, chuẩn xác và dễ hiểu.", bold_prefix="5. Trợ lý ảo AI hỏi đáp lịch sử (AI Assistant):")
    add_bullet_item(doc, " Khách tham quan lựa chọn ngày đến, số lượng vé người lớn và vé trẻ em, nhập họ tên và địa chỉ email nhận vé. Hệ thống tự động tạo mã thanh toán VietQR động tương ứng với tổng số tiền của đơn hàng thông qua cổng thanh toán PayOS theo tiêu chuẩn kỹ thuật thanh toán của Ngân hàng Nhà nước Việt Nam [18]. Khách mở ứng dụng ngân hàng trên điện thoại quét mã QR để chuyển khoản. Ngay khi giao dịch hoàn tất thành công, máy chủ xác nhận tự động và gửi vé điện tử chứa mã QR định danh duy nhất về hộp thư điện tử của khách.", bold_prefix="6. Đặt mua vé trực tuyến và Thanh toán VietQR:")

    p_cap_3_2 = doc.add_paragraph()
    format_paragraph(p_cap_3_2, space_before=6, space_after=6, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    set_run_font(p_cap_3_2.add_run("Hình 3.2: Giao diện Tham quan thực tế ảo 360° tích hợp Mini-map và Điểm chuyển phòng"), "Times New Roman", 11, bold=True, italic=True, color_rgb=COLOR_BLACK)

    add_heading_3(doc, "3.3.2. Phân hệ dành cho Ban Quản trị (Admin Portal)")
    add_body_p(doc, "Cung cấp bộ công cụ quản trị tập trung, bảo mật và trực quan cho cán bộ chuyên môn và ban giám đốc bảo tàng:")
    add_bullet_item(doc, " Đăng nhập bảo mật JWT và mật khẩu băm bcrypt. Phân quyền RBAC lưu trữ trong PostgreSQL phân định rõ các vai trò: Quản trị viên tối cao (Super Admin), Cán bộ nội dung (Content Manager) và Nhân viên kiểm soát vé (Ticket Inspector).", bold_prefix="1. Xác thực và Kiểm soát phân quyền (AdminLoginPage.tsx, models/Role.ts):")
    add_bullet_item(doc, " Hỗ trợ tải video quay lia máy bằng điện thoại thông thường, đẩy tác vụ sang hàng đợi Redis (stitchQueue) để tiến trình ngầm stitcher.py tự động nắn phẳng, so khớp RootSIFT, ước lượng Homography RANSAC và hòa trộn đa băng tần; hiển thị thanh tiến độ phần trăm thời gian thực.", bold_prefix="2. Xưởng xử lý ghép ảnh 360° tự động (PocStitchingPage.tsx, stitcher.py):")
    add_bullet_item(doc, " Người quản trị xoay không gian phòng và nhấp chuột trực tiếp lên cửa đi trên mặt cầu. Thuật toán Raycasting tự động chuyển tọa độ click (x, y) thành góc cầu (Pitch, Yaw), liên kết với phòng đích trong danh sách 18 phòng và thiết lập góc nhìn mặc định camera.", bold_prefix="3. Xưởng biên tập không gian và Cắm điểm Hotspot 3D (AdminPanoramaStudio.tsx):")
    add_bullet_item(doc, " Quản lý danh mục bảo vật quốc gia và hiện vật lịch sử theo từng phòng. Tích hợp 2 động cơ: Động cơ Heuristic CPU nội bộ (artifact_3d_generator.py) chạy trên VPS không cần GPU, và Động cơ AI Diffusion GPU Đám mây (trellisClient.ts) suy diễn hình khối 3D toàn diện.", bold_prefix="4. Quản lý Cổ vật và Số hóa 3D Đa Động cơ (AdminArtifactsPage.tsx):")
    add_bullet_item(doc, " Quản lý toàn bộ nhận diện thương hiệu (Tên bảo tàng tiếng Việt/Anh, Emblem, Tagline, tải Logo lên Cloudinary có gắn cờ bảo mật fl_sanitize) và cấu hình Banner Hero toàn cảnh, video nền, các nút CTA và khối trưng bày. Dữ liệu lưu trong bảng system_branding của PostgreSQL và đồng bộ realtime sang client.", bold_prefix="5. Quản trị Giao diện & Nội dung Trang chủ CMS (AdminHomepageCMSPage.tsx):")
    add_bullet_item(doc, " Tải lên và hiệu chỉnh sơ đồ mặt bằng kiến trúc bảo tàng (FloorPlanMap). Ứng dụng thị giác máy tính nhận diện cấu trúc cửa thông phòng, định vị mốc tọa độ và tự động đồng bộ đồ thị liên thông cho thuật toán tìm đường Dijkstra.", bold_prefix="6. Quản trị Sơ đồ Mặt bằng & Phân tích Cấu trúc Liên thông (AdminFloorPlanMappingPage.tsx):")
    add_bullet_item(doc, " Quản lý đơn hàng mua vé trực tuyến, lịch sử thanh toán VietQR qua PayOS, cấu hình bảng giá vé (vé người lớn, trẻ em) và khung giờ tham quan (buổi sáng: 08:00 – 11:30, buổi chiều: 13:30 – 17:00), bộ lọc vé đa năng theo ngày và trạng thái.", bold_prefix="7. Quản lý Vé & Cấu hình Đơn hàng (AdminTicketsPage.tsx):")
    add_bullet_item(doc, " Ghi nhận chi tiết mọi hoạt động can thiệp dữ liệu của người dùng (thao tác thêm, sửa, xóa phòng, cổ vật, giá vé, địa chỉ IP và mốc thời gian) vào bảng audit_logs trong PostgreSQL phục vụ an toàn thông tin và chống gian lận.", bold_prefix="8. Giám sát Hệ thống & Nhật ký Kiểm toán (AdminLogsPage.tsx, models/AuditLog.ts):")

    p_cap_3_3 = doc.add_paragraph()
    format_paragraph(p_cap_3_3, space_before=6, space_after=6, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    set_run_font(p_cap_3_3.add_run("Hình 3.3: Giao diện Xưởng quản trị Studio 360° và Quản trị Giao diện Trang chủ CMS"), "Times New Roman", 11, bold=True, italic=True, color_rgb=COLOR_BLACK)

    add_heading_3(doc, "3.3.3. Phân hệ Soát vé bảo tàng trực tiếp bằng Camera QR (Ticket Inspection Portal)")
    add_body_p(doc, "Được thiết kế và tối ưu riêng cho giao diện điện thoại thông minh của nhân viên bảo vệ tại cổng bảo tàng:")
    add_bullet_item(doc, " Khai thác trực tiếp camera điện thoại qua thư viện Html5QrcodeScanner để quét mã phản hồi nhanh trên vé điện tử của khách.", bold_prefix="- Quét mã QR thời gian thực trên trình duyệt di động:")
    add_bullet_item(doc, " Khi nhận diện mã vé chuẩn BTLS-YYYY-XXXXXXXX, hệ thống truy vấn trực tiếp bảng tickets trong PostgreSQL. Nếu vé hợp lệ và chưa sử dụng, trạng thái lập tức chuyển sang 'used', ghi nhận used_at = CURRENT_TIMESTAMP và hiển thị thẻ xanh 'Vé hợp lệ – Đã xác nhận vào cổng'. Giao diện tự động đồng bộ theo thời gian thực mà không cần người dùng tải lại trang.", bold_prefix="- Xác thực vé và cập nhật trạng thái tức thời:")
    add_bullet_item(doc, " Nếu vé đã được quét trước đó hoặc mã vé không tồn tại trong hệ thống, màn hình lập tức hiển thị cảnh báo đỏ từ chối vào cổng và nêu rõ thời điểm vé đã sử dụng trước đó, ngăn chặn triệt để hành vi quay vòng vé.", bold_prefix="- Chống gian lận vé quay vòng tuyệt đối:")

    p_cap_3_4 = doc.add_paragraph()
    format_paragraph(p_cap_3_4, space_before=6, space_after=6, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    set_run_font(p_cap_3_4.add_run("Hình 3.4: Giao diện Camera quét mã QR soát vé khách vào cổng trên thiết bị di động"), "Times New Roman", 11, bold=True, italic=True, color_rgb=COLOR_BLACK)

    add_heading_2(doc, "3.4. Phân tích các yêu cầu phi chức năng (Non-functional Requirements)")
    add_body_p(doc, "Để đảm bảo hệ thống vận hành bền vững trong môi trường triển khai thực tế trên máy chủ đám mây (Cloud VPS), các chỉ tiêu kỹ thuật phi chức năng được xác định cụ thể như sau:")
    add_bullet_item(doc, " Thời gian tải trang ban đầu và nạp không gian 360 độ phải đạt dưới 1,5 giây trên kết nối mạng thông thường. Tốc độ kết xuất khung hình (FPS) trên máy tính đạt chuẩn 60 FPS; trên thiết bị di động đạt từ 45 đến 60 FPS mượt mà. Dung lượng mỗi tệp mô hình cổ vật 3D được tối ưu hóa ở mức 2 đến 5 MB để tải nhanh qua mạng di động 4G.", bold_prefix="1. Hiệu năng và Tốc độ phản hồi:")
    add_bullet_item(doc, " Giao diện chuẩn đáp ứng (Responsive Design), tự động co giãn tối ưu bố cục trên cả máy tính, máy tính bảng và điện thoại. Thao tác điều khiển trực quan: chạm vuốt xoay nhìn hoặc nhấp chuột vào mũi tên để di chuyển, không yêu cầu kiến thức kỹ thuật phức tạp.", bold_prefix="2. Tính khả dụng và Trải nghiệm người dùng:")
    add_bullet_item(doc, " Áp dụng cơ chế xử lý bất đồng bộ qua hàng đợi Redis, đảm bảo khi có nhiều quản trị viên cùng tải video lên ghép ảnh thì máy chủ web vẫn hoạt động ổn định. Mã nguồn máy trạm chủ động giải phóng bộ nhớ RAM khi chuyển phòng để chống hiện tượng tràn RAM trên điện thoại.", bold_prefix="3. Tính mở rộng và Độ ổn định:")
    add_bullet_item(doc, " Toàn bộ lưu lượng truy cập được mã hóa an toàn qua HTTPS với chứng chỉ số Let's Encrypt. Máy chủ Nginx thiết lập tường lửa giới hạn tần suất yêu cầu (tối đa 30 yêu cầu/giây) và giới hạn kết nối mở đồng thời để chống tấn công từ chối dịch vụ. Kiểm định nghiêm ngặt tên tệp tải lên để ngăn chặn lỗ hổng duyệt đường dẫn trái phép.", bold_prefix="4. An toàn thông tin và Bảo mật dữ liệu:")

    add_heading_2(doc, "3.5. Biểu đồ ca sử dụng tổng quát (Use Case Diagram)")
    add_body_p(doc, "Dựa trên việc phân tích các nhóm tác nhân và yêu cầu chức năng, mô hình ca sử dụng tổng quát của hệ thống được tổng hợp như sau:")

    # Sơ đồ Use Case Diagram
    add_centered_image(doc, "baocaokhoaluan/assets/hinh_3_5_so_do_use_case.png",
                       "Hình 3.5: Sơ đồ ca sử dụng tổng quát (Use Case Diagram) của Hệ thống Tham quan 360° & Số hóa Cổ vật", width_cm=15.0)

    p_cap_tbl31 = doc.add_paragraph()
    format_paragraph(p_cap_tbl31, space_before=6, space_after=3, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    p_cap_tbl31.paragraph_format.keep_with_next = True
    set_run_font(p_cap_tbl31.add_run("Bảng 3.1: Bảng tổng hợp phân loại các ca sử dụng chính trong hệ thống"), "Times New Roman", 12, bold=True, italic=True, color_rgb=COLOR_BLACK)

    tbl_3_1 = doc.add_table(rows=12, cols=4)
    tbl_3_1.style = 'Table Grid'
    tbl_3_1.alignment = WD_TABLE_ALIGNMENT.CENTER
    tbl_3_1.autofit = False
    set_table_borders(tbl_3_1, color="000000", sz="6")

    widths_3_1 = [Cm(2.2), Cm(4.5), Cm(3.8), Cm(5.5)]
    for r in tbl_3_1.rows:
        make_row_cant_split(r)
        for c_idx, w in enumerate(widths_3_1):
            r.cells[c_idx].width = w
            set_cell_margins(r.cells[c_idx], top=90, bottom=90, left=130, right=130)
            set_cell_vertical_alignment(r.cells[c_idx], "center")

    make_row_header(tbl_3_1.rows[0])

    headers_3_1 = ["Mã ca sử dụng", "Tên ca sử dụng (Use Case)", "Tác nhân chính (Actor)", "Mô tả tóm tắt nghiệp vụ"]
    for c_idx, h_text in enumerate(headers_3_1):
        cell = tbl_3_1.cell(0, c_idx)
        cell.paragraphs[0].text = ""
        p = cell.paragraphs[0]
        format_paragraph(p, space_before=4, space_after=4, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
        set_run_font(p.add_run(h_text), "Times New Roman", 10.5, bold=True, color_rgb=COLOR_BLACK)
        set_cell_background(cell, "EAECEF")

    data_3_1 = [
        ("UC-01", "Tham quan không gian 360°", "Khách tham quan", "Xoay nhìn 4 hướng, bước qua các cửa phòng trưng bày."),
        ("UC-02", "Dẫn đường Mini-map (Dijkstra)", "Khách tham quan", "Xem sơ đồ 18 phòng, tìm lộ trình đi ngắn nhất đến phòng đích."),
        ("UC-03", "Tương tác Cổ vật 3D (.GLB)", "Khách tham quan", "Xoay lật 360 độ, phóng to thu nhỏ ngắm hoa văn hiện vật."),
        ("UC-04", "Nghe thuyết minh âm thanh", "Khách tham quan", "Chuyển đổi ngôn ngữ Việt - Anh, phát âm thanh hướng dẫn."),
        ("UC-05", "Hỏi đáp Trợ lý AI", "Khách tham quan", "Trò chuyện, tra cứu thông tin lịch sử về hiện vật trong phòng."),
        ("UC-06", "Mua vé trực tuyến (PayOS)", "Khách tham quan", "Chọn loại vé, quét mã VietQR và nhận vé điện tử qua email."),
        ("UC-07", "Đăng nhập hệ thống quản trị", "Ban quản trị", "Nhập tài khoản, nhận mã thông hành bảo mật JWT."),
        ("UC-08", "Ghép ảnh 360° từ video", "Ban quản trị", "Tải video lên, theo dõi tiến trình xử lý ngầm qua Redis."),
        ("UC-09", "Cắm điểm chuyển phòng (Hotspot)", "Ban quản trị", "Nhấp chuột lên cửa phòng, tính tọa độ cầu và lưu điểm nối."),
        ("UC-10", "Quản lý hiện vật & Số hóa 3D", "Ban quản trị", "Cập nhật thông tin cổ vật, tạo mô hình 3D từ ảnh đơn."),
        ("UC-11", "Soát vé bằng camera QR", "Nhân viên soát vé", "Dùng camera điện thoại quét mã vé, cập nhật trạng thái vé.")
    ]

    for r_idx, row_data in enumerate(data_3_1):
        for c_idx, val in enumerate(row_data):
            cell = tbl_3_1.cell(r_idx + 1, c_idx)
            cell.paragraphs[0].text = ""
            p = cell.paragraphs[0]
            align_choice = WD_ALIGN_PARAGRAPH.CENTER if (c_idx == 0 or c_idx == 2) else WD_ALIGN_PARAGRAPH.JUSTIFY
            format_paragraph(p, space_before=3, space_after=3, line_spacing=1.15, align=align_choice, first_indent=0.0, left_indent=0.0)
            set_run_font(p.add_run(val), "Times New Roman", 10.5, bold=(c_idx == 0), color_rgb=COLOR_BLACK)


    # =========================================================================
    # CHƯƠNG 4: HIỆN THỰC HÓA VÀ ĐÁNH GIÁ THỰC NGHIỆM
    # =========================================================================
    doc.add_page_break()
    add_heading_1(doc, "CHƯƠNG 4. HIỆN THỰC HÓA VÀ ĐÁNH GIÁ THỰC NGHIỆM")

    add_body_p(doc, "Chương này trình bày chi tiết kết quả hiện thực hóa toàn bộ các phân hệ chức năng của hệ thống dựa trên mã nguồn thực tế tại kho lưu trữ dự án; đồng thời công bố các kết quả kiểm thử, đo đạc hiệu năng và phân tích so sánh thực nghiệm chuyên sâu giữa hai phương pháp tái tạo mô hình 3D cổ vật (phương pháp nội suy hình học thể tích Heuristic chạy trên CPU máy chủ nội bộ và phương pháp khuếch tán AI TRELLIS chạy trên GPU đám mây) cùng kết quả kiểm thử thực địa tại Bảo tàng Lịch sử TP. Hồ Chí Minh qua 4 đợt tác nghiệp.")

    add_heading_2(doc, "4.1. Hiện thực hóa các phân hệ chức năng của hệ thống")
    add_body_p(doc, "Bám sát mô hình kiến trúc phân tầng đã thiết kế, hệ thống được cài đặt hoàn chỉnh và vận hành thực tế trên máy chủ đám mây (Cloud VPS), bao gồm 5 phân hệ chức năng nghiệp vụ trọng tâm:")

    add_heading_3(doc, "4.1.1. Hiện thực hóa Phân hệ Xưởng ghép ảnh toàn cảnh 360° tự động")
    add_body_p(doc, "Phân hệ này giải quyết bài toán cốt lõi về việc tự chủ dữ liệu không gian với chi phí thiết bị 0 đồng, cho phép ban quản trị chuyển hóa video quay phòng bằng điện thoại thông thường thành ảnh toàn cảnh Equirectangular chuẩn tỷ lệ 2:1:")
    add_bullet_item(doc, " Người quản trị lựa chọn tệp video quay quét không gian gian phòng (định dạng MP4 hoặc MOV). Khi bấm nút bắt đầu xử lý, video được tải lên máy chủ Node.js qua bộ định tuyến routes/stitch.ts. Máy chủ khởi tạo bản ghi tác vụ (Stitching Job) với mã định danh duy nhất và đẩy vào hàng đợi Redis (stitchQueue). Giao diện sử dụng kỹ thuật Server-Sent Events (SSE) để lắng nghe sự kiện tiến độ từ máy chủ, hiển thị thanh tiến trình phần trăm (%) thời gian thực kèm thông báo trạng thái từng bước.", bold_prefix="- Giao diện điều phối tác vụ (frontend/src/pages/PocStitchingPage.tsx):")
    add_bullet_item(doc, " Tiến trình phân tích luồng video, loại bỏ các khung hình bị nhòe mờ do rung lắc tay và chỉ giữ lại các khung hình sắc nét có độ gối mí không gian từ 60% đến 75%; áp dụng phép biến đổi lượng giác dựa trên tiêu cự f để uốn cong các khung hình phẳng lên mặt trụ; trích xuất véc-tơ RootSIFT 128 chiều và lọc nhiễu qua RANSAC với ngưỡng sai số 3,0 px; tối ưu hóa đường cắt ghép Voronoi Seam và hòa trộn đa băng tần Laplacian; tự động nội suy làm mịn đáy sàn Nadir để trả về bức ảnh 360° hoàn chỉnh khép kín.", bold_prefix="- Động cơ xử lý ảnh ngầm (stitching_worker/stitcher.py):")

    add_placeholder_box_word(doc, "Hình 4.1: Giao diện Xưởng xử lý ghép ảnh toàn cảnh 360° tự động (PocStitchingPage) và tiến trình Worker ngầm",
                             width_cm=14.5,
                             label="KHU VỰC DÀNH CHO TÁC GIẢ CHÈN ẢNH CHỤP GIAO DIỆN XƯỞNG GHÉP ẢNH (POC STITCHING)",
                             note="Chụp ảnh giao diện PocStitchingPage khi tải video và chạy tiến trình ghép ảnh để chèn vào khung này (Tỷ lệ 16:9)")

    add_heading_3(doc, "4.1.2. Hiện thực hóa Phân hệ Cổng tham quan tương tác 360° và Bản đồ dẫn đường")
    add_body_p(doc, "Cung cấp không gian tham quan thực tế ảo sống động cho công chúng trên trình duyệt máy tính và thiết bị di động mà không cần cài đặt ứng dụng:")
    add_bullet_item(doc, " Khởi tạo môi trường đồ họa WebGL thông qua thư viện Three.js với khối cầu SphereGeometry(500, 60, 40). Bức ảnh toàn cảnh Equirectangular được dán vào mặt trong của khối cầu bằng chất liệu MeshBasicMaterial. Tích hợp bộ điều khiển OrbitControls cho phép người dùng kéo chuột hoặc vuốt ngón tay để xoay nhìn tự do 360° theo chiều ngang và 180° theo chiều dọc.", bold_prefix="- Kết xuất không gian hình cầu tương tác (ClientTourView.tsx):")
    add_bullet_item(doc, " Các điểm cửa thông phòng được biểu diễn bằng các sprite mũi tên 3D nhấp nháy định vị tại tọa độ cầu (θ, φ). Khi người dùng nhấp vào mũi tên, hệ thống áp dụng hiệu ứng làm mờ dần (Fade-out/Fade-in) trong 400 ms, đồng thời tự động gọi hàm dispose() để giải phóng toàn bộ kết cấu (Texture) và hình học (Geometry) của phòng cũ ra khỏi bộ nhớ GPU trước khi nạp phòng mới, ngăn ngừa triệt để lỗi tràn RAM trên điện thoại.", bold_prefix="- Định vị và kích hoạt điểm chuyển phòng Hotspots:")
    add_bullet_item(doc, " Tích hợp sơ đồ mặt bằng kiến trúc liên hoàn của 18 gian phòng (FloorPlanMap). Hiển thị hình nón radar (Radar View) biểu thị trực quan hướng quay và góc nhìn hiện tại của người dùng trên bản đồ số. Khi khách tham quan nhấp chọn một phòng đích đến bất kỳ, thuật toán Dijkstra (floorPlanNavigator.ts) tính toán lộ trình tối ưu và vẽ đường viền nối liền các phòng cần đi qua.", bold_prefix="- Bản đồ thu nhỏ thông minh (Mini-map & Dijkstra Navigation):")
    add_bullet_item(doc, " Trình phát âm thanh tự động nạp giọng đọc truyền cảm song ngữ (Việt - Anh) tương ứng với từng thời kỳ lịch sử. Khung cửa sổ trò chuyện thông minh tích hợp mô hình ngôn ngữ lớn Google Gemini API (gemini-2.5-flash). Khi khách đặt câu hỏi, máy chủ tự động nạp dữ liệu lịch sử của gian phòng và hiện vật đang quan sát vào ngữ cảnh (Lightweight RAG) để trợ lý AI giải đáp ngắn gọn, chuẩn xác và đúng tư liệu của bảo tàng.", bold_prefix="- Thuyết minh âm thanh song ngữ & Trợ lý ảo Google Gemini (services/aiService.ts):")

    add_centered_image(doc, "baocaokhoaluan/assets/real_client_interactive_tour360.png",
                       "Hình 4.2: Giao diện Cổng tham quan 360° thực tế tích hợp Mini-map dẫn đường và Trợ lý AI hỏi đáp (triển khai tại https://museumhcm.duckdns.org)", width_cm=14.5)

    add_heading_3(doc, "4.1.3. Hiện thực hóa Phân hệ Số hóa và Tương tác Cổ vật 3D Đa Động cơ")
    add_body_p(doc, "Phân hệ này cho phép công chúng tiếp cận gần gũi với các bảo vật quý vốn bị ngăn cách sau các tủ kính dày tại bảo tàng:")
    add_bullet_item(doc, " Sử dụng thư viện @react-three/fiber và @react-three/drei để tải và kết xuất tệp mô hình nhị phân chuẩn quốc tế .GLB. Khách tham quan có thể xoay lật 360 độ vật thể, phóng to cực đại để kiểm tra chất liệu gốm men, vết chạm khắc đá Champa hoặc hoa văn kim loại cổ. Giao diện cung cấp bảng hồ sơ khoa học chi tiết: Tên cổ vật, niên đại lịch sử, nguồn gốc khai quật, chất liệu chế tác, kích thước thực tế và ý nghĩa văn hóa khảo cổ học.", bold_prefix="- Trình tương tác Cổ vật 3D trực quan (ClientArtifactDetailView.tsx & PublicArtifactView.tsx):")
    add_bullet_item(doc, " Nhận 1 ảnh chụp mặt trước của cổ vật, tự động bóc tách phông nền bằng mạng tích chập U2-Net. Tính toán biến đổi khoảng cách Euclid (Euclidean Distance Transform) từ đường biên vào trục tâm đối xứng, sau đó áp dụng hàm vòm cầu điều hòa liên tục (Harmonic Volumetric Envelope) để tạo khối thể tích phồng tự nhiên. Thực hiện mở rộng mép ảnh (Texture Dilation) 18 chu kỳ để khử viền đen và tính toán Normal Map làm nổi bật độ sần sùi bề mặt. Đóng gói thành tệp .GLB nhẹ chỉ từ 2 - 5 MB, chạy hoàn toàn trên CPU của VPS mà không đòi hỏi phần cứng GPU chuyên dụng.", bold_prefix="- Hiện thực hóa Động cơ sinh 3D Heuristic nội bộ (stitching_worker/artifact_3d_generator.py):")
    add_bullet_item(doc, " Kết nối với dịch vụ mô hình AI khuếch tán không gian 3D (TRELLIS) trên máy chủ GPU đám mây. Cho phép tái tạo hoàn chỉnh cả hình khối mặt sau và cấu trúc rỗng bên trong cho các hiện vật có độ phức tạp hình học cao (như đỉnh đồng nhiều quai, tượng tròn đa diện).", bold_prefix="- Hiện thực hóa Động cơ sinh 3D AI GPU Đám mây (trellisClient.ts & trellis_service.py):")

    add_centered_image(doc, "baocaokhoaluan/assets/real_client_artifacts_section.png",
                       "Hình 4.3: Giao diện Trưng bày Cổ vật 3D tương tác xoay phóng và Bảng thông tin di sản trên hệ thống trực tuyến", width_cm=14.5)

    add_heading_3(doc, "4.1.4. Hiện thực hóa Phân hệ Quản trị Giao diện CMS & Nhận diện Thương hiệu")
    add_body_p(doc, "Giúp ban giám đốc và cán bộ bảo tàng hoàn toàn tự chủ trong việc biên tập hình ảnh và nội dung mà không cần can thiệp vào mã nguồn:")
    add_bullet_item(doc, " Biên tập tên chính thức và tên viết tắt (Emblem), khẩu hiệu di sản (Tagline) bằng hai ngôn ngữ tiếng Việt và tiếng Anh. Tải lên biểu trưng Logo chính thức lên hệ thống Cloudinary CDN, tự động kích hoạt cờ bảo mật fl_sanitize để làm sạch mã độc trong tệp SVG/PNG trước khi lưu vào cơ sở dữ liệu PostgreSQL.", bold_prefix="- Quản lý Nhận diện thương hiệu (AdminHomepageCMSPage.tsx & models/SystemBranding.ts):")
    add_bullet_item(doc, " Tùy biến tiêu đề chào đón, đoạn phụ đề dẫn dắt, tải ảnh nền toàn cảnh độ phân giải cao hoặc video nền giới thiệu bảo tàng. Cấu hình các nút bấm chuyển hướng nhanh (CTA) dẫn trực tiếp vào Tour 360° hoặc danh mục Cổ vật 3D tiêu biểu. Khi người quản trị nhấn lưu thay đổi, sự kiện được phát tán tự động qua kênh SSE (realtimeSync.ts), giúp toàn bộ màn hình của khách tham quan đang mở trên web lập tức cập nhật giao diện mới mà không bị gián đoạn trải nghiệm.", bold_prefix="- Quản lý Khung Banner Hero toàn cảnh và Khối trưng bày:")

    add_centered_image(doc, "baocaokhoaluan/assets/real_admin_page.png",
                       "Hình 4.4: Giao diện Cổng Quản trị hệ thống (Admin Portal) tại https://museumhcm.duckdns.org/admin", width_cm=14.5)

    add_heading_3(doc, "4.1.5. Hiện thực hóa Phân hệ Đặt vé trực tuyến VietQR và Soát vé Camera QR")
    add_body_p(doc, "Hiện đại hóa toàn diện quy trình đón tiếp khách, loại bỏ vé giấy truyền thống và ngăn chặn gian lận:")
    add_bullet_item(doc, " Khách tham quan chọn ngày đến, khung giờ tham quan (buổi sáng: 08:00 - 11:30, buổi chiều: 13:30 - 17:00), số lượng vé người lớn và vé trẻ em. Hệ thống tự động gọi API của cổng thanh toán VietQR PayOS để tạo mã phản hồi nhanh kèm số tiền và mã đơn hàng duy nhất. Khi khách chuyển khoản thành công, Webhook PayOS gửi thông báo xác nhận tự động về máy chủ Node.js. Hệ thống lập tức sinh các mã vé điện tử định dạng chuẩn BTLS-YYYY-XXXXXXXX (ví dụ BTLS-2026-0BBE60), tạo ảnh mã QR bảo mật và gửi thư xác nhận điện tử kèm vé về email của khách (services/mail.ts).", bold_prefix="- Cổng đặt vé trực tuyến VietQR (ClientTicketBookingPage.tsx & services/payos.ts):")
    add_bullet_item(doc, " Tích hợp thư viện Html5QrcodeScanner trực tiếp trên trình duyệt điện thoại của nhân viên kiểm soát tại cửa bảo tàng. Khi quét mã QR trên vé điện tử của khách, hệ thống gửi mã vé về máy chủ để truy vấn trực tiếp bảng tickets trong PostgreSQL: Nếu vé hợp lệ và chưa sử dụng, hệ thống lập tức cập nhật trạng thái used, ghi nhận thời gian vào cổng used_at = CURRENT_TIMESTAMP, hiển thị khung xanh thông báo hợp lệ, và bảng vé quản trị viên lập tức cập nhật trạng thái sang Đã sử dụng theo thời gian thực; Nếu vé gian lận hoặc đã quét trước đó, màn hình hiển thị cảnh báo đỏ từ chối vào cổng.", bold_prefix="- Phân hệ Soát vé Camera QR trên thiết bị di động (AdminTicketsPage.tsx & services/qr.ts):")

    add_centered_image(doc, "baocaokhoaluan/assets/real_client_booking_vietqr.png",
                       "Hình 4.5: Giao diện Cổng đặt vé trực tuyến VietQR PayOS và thanh toán tự động trên hệ thống", width_cm=14.5)

    add_heading_2(doc, "4.2. Đánh giá thực nghiệm và Kết quả đo lường hiệu năng")

    add_heading_3(doc, "4.2.1. Kịch bản thực nghiệm thực tế tại Bảo tàng Lịch sử TP.HCM qua 4 đợt tác nghiệp")
    add_body_p(doc, "Toàn bộ hệ thống phần mềm và dữ liệu số hóa được kiểm thử nghiêm ngặt tại hiện trường khuôn viên Bảo tàng Lịch sử TP.HCM (Số 2 Nguyễn Bỉnh Khiêm, Phường Bến Nghé, Quận 1):")
    add_bullet_item(doc, " Ghi nhận cấu trúc 18 gian phòng nối tiếp nhau quanh sân trong; đo đạc vị trí các cửa thông phòng để thiết lập đồ thị liên thông cho giải thuật Dijkstra; ghi nhận thách thức ánh sáng yếu và hiện tượng lóa đèn rọi vàng chiếu vào tủ kính.", bold_prefix="- Đợt 1 (Khảo sát hiện trạng kiến trúc và liên thông cửa):")
    add_bullet_item(doc, " Thử nghiệm quay lia máy 360 độ góc rộng (0,5x) tại các phòng đại diện. Phát hiện và xử lý thành công lỗi lệch mí nối góc tường khi lia máy không đều tay, lỗi dính bóng chân người chụp ở vùng sàn Nadir và hiện tượng chói sáng cục bộ.", bold_prefix="- Đợt 2 (Thử nghiệm quay quét bằng điện thoại và tối ưu thuật toán):")
    add_bullet_item(doc, " Ghi hình chuẩn toàn bộ 18 gian phòng; chụp ảnh đa góc các bảo vật tiêu biểu (tượng Champa thế kỷ VII, gốm men Lý - Trần, tượng Phật phương Nam); ghi âm tư liệu thuyết minh song ngữ và nạp tri thức bảo tàng vào trợ lý AI.", bold_prefix="- Đợt 3 (Thu thập dữ liệu chính thức 18 phòng và cổ vật 3D):")
    add_bullet_item(doc, " Triển khai toàn bộ hệ thống lên máy chủ đám mây trực tuyến; kiểm thử tốc độ tải Tour 360° trên kết nối mạng di động 4G tại các phòng sâu bên trong khuôn viên; thực hiện quy trình mua vé qua VietQR và cầm điện thoại quét mã QR soát vé trực tiếp tại cửa ra vào để kiểm tra độ nhạy và tính ổn định.", bold_prefix="- Đợt 4 (Thực nghiệm toàn diện trên mạng di động 4G tại cổng bảo tàng):")

    add_placeholder_box_word(doc, "Hình 4.6: Hình ảnh nhóm sinh viên tác nghiệp thực tế tại Bảo tàng Lịch sử TP.HCM",
                             width_cm=14.0,
                             label="KHU VỰC DÀNH CHO NHÓM TÁC GIẢ CHÈN ẢNH CHỤP THỰC TẾ TẠI BẢO TÀNG",
                             note="Kéo thả hoặc nhấp chọn ảnh chụp thực tế của nhóm sinh viên đi khảo sát tại Bảo tàng Lịch sử TP.HCM để chèn vào khung này (Tỷ lệ 16:9 hoặc 4:3)")

    add_heading_3(doc, "4.2.2. So sánh thực nghiệm chuyên sâu giữa hai Động cơ tái tạo Cổ vật 3D")
    add_body_p(doc, "Để làm rõ giá trị khoa học và tính thực tiễn của đề tài, nhóm tiến hành thực nghiệm so sánh song song giữa hai phương pháp tạo mô hình 3D từ một ảnh duy nhất: Phương pháp 1 (Nội suy hình học thể tích Heuristic chạy trên CPU nội bộ) và Phương pháp 2 (Mô hình khuếch tán AI TRELLIS chạy trên GPU đám mây).")

    p_cap_tbl41 = doc.add_paragraph()
    format_paragraph(p_cap_tbl41, space_before=6, space_after=3, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    p_cap_tbl41.paragraph_format.keep_with_next = True
    set_run_font(p_cap_tbl41.add_run("Bảng 4.1: Bảng so sánh thực nghiệm toàn diện giữa hai Động cơ tái tạo mô hình Cổ vật 3D"), "Times New Roman", 12, bold=True, italic=True, color_rgb=COLOR_BLACK)

    tbl_4_1 = doc.add_table(rows=9, cols=3)
    tbl_4_1.style = 'Table Grid'
    tbl_4_1.alignment = WD_TABLE_ALIGNMENT.CENTER
    tbl_4_1.autofit = False
    set_table_borders(tbl_4_1, color="000000", sz="6")

    widths_4_1 = [Cm(3.2), Cm(6.4), Cm(6.4)]
    for r in tbl_4_1.rows:
        make_row_cant_split(r)
        for c_idx, w in enumerate(widths_4_1):
            r.cells[c_idx].width = w
            set_cell_margins(r.cells[c_idx], top=90, bottom=90, left=130, right=130)
            set_cell_vertical_alignment(r.cells[c_idx], "center")

    make_row_header(tbl_4_1.rows[0])

    headers_4_1 = ["Tiêu chí so sánh", "Động cơ 1: Nội suy hình học thể tích Heuristic CPU (artifact_3d_generator.py)", "Động cơ 2: AI Diffusion Đám mây TRELLIS GPU (trellisClient.ts)"]
    for c_idx, h_text in enumerate(headers_4_1):
        cell = tbl_4_1.cell(0, c_idx)
        cell.paragraphs[0].text = ""
        p = cell.paragraphs[0]
        format_paragraph(p, space_before=4, space_after=4, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
        set_run_font(p.add_run(h_text), "Times New Roman", 10.5, bold=True, color_rgb=COLOR_BLACK)
        set_cell_background(cell, "EAECEF")

    data_4_1 = [
        ("Yêu cầu phần cứng", "Chạy hoàn toàn trên CPU thông thường của VPS (2 - 4 vCPU, 4GB RAM), không cần card đồ họa GPU.", "Bắt buộc phải có card đồ họa GPU chuyên dụng cấu hình cao (NVIDIA A100 / V100 / RTX 4090 có VRAM >= 16 GB)."),
        ("Chi phí hạ tầng", "0 đồng phụ trội: Tận dụng ngay tài nguyên máy chủ web hiện có của bảo tàng.", "Tốn chi phí thuê máy chủ GPU đám mây hàng tháng hoặc trả phí theo từng lượt gọi API (Pay-per-request)."),
        ("Thời gian tạo mô hình", "Cực nhanh (3 - 6 giây): Xử lý toán học tức thì từ khi tải ảnh lên.", "Chậm (35 - 90 giây): Phụ thuộc thời gian nạp trọng số mô hình khuếch tán và độ trễ truyền dữ liệu mạng."),
        ("Tính tự chủ dữ liệu", "Tự chủ hoàn toàn 100%: Mã nguồn chạy trên hạ tầng nội bộ của bảo tàng, không phụ thuộc bên thứ ba.", "Phụ thuộc dịch vụ ngoài: Khi nhà cung cấp GPU bảo trì hoặc mất kết nối API, chức năng sẽ bị gián đoạn."),
        ("Độ chân thực mặt trước", "Rất cao: Bảo toàn 100% độ sắc nét hoa văn, màu sắc thực tế và vết sần sùi nhờ Normal Map.", "Rất cao: Tái tạo chi tiết và phối màu bề mặt mượt mà nhờ mạng nơ-ron học sâu."),
        ("Hình khối mặt sau", "Nội suy phồng thể tích đối xứng trơn tru; không tái tạo được hoa văn riêng biệt ở mặt sau.", "Suy diễn thể tích toàn diện: Tái tạo được hình khối đa chiều và các chi tiết bất đối xứng ở mặt sau."),
        ("Dung lượng tệp .GLB", "Rất nhẹ (1,8 - 3,5 MB): Đã tối ưu hóa số lượng đa giác (Mesh Decimation), nạp siêu nhanh trên điện thoại.", "Khá nặng (8 - 25 MB): Lưới đa giác dày đặc, đòi hỏi kết nối mạng mạnh để tải về máy trạm."),
        ("Phạm vi ứng dụng tối ưu", "Hoàn hảo cho 85% hiện vật bảo tàng: Tượng đá gắn vách, phù điêu, đĩa gốm, trang phục cổ đặt sát tường.", "Phù hợp cho các cổ vật hình khối phức tạp đặt giữa phòng: Đỉnh đồng nhiều quai, vạc đồng, chuông cổ.")
    ]

    for r_idx, row_data in enumerate(data_4_1):
        for c_idx, val in enumerate(row_data):
            cell = tbl_4_1.cell(r_idx + 1, c_idx)
            cell.paragraphs[0].text = ""
            p = cell.paragraphs[0]
            align_choice = WD_ALIGN_PARAGRAPH.CENTER if c_idx == 0 else WD_ALIGN_PARAGRAPH.JUSTIFY
            format_paragraph(p, space_before=3, space_after=3, line_spacing=1.15, align=align_choice, first_indent=0.0, left_indent=0.0)
            set_run_font(p.add_run(val), "Times New Roman", 10.5, bold=(c_idx == 0), color_rgb=COLOR_BLACK)

    add_body_p(doc, "Bàn luận khoa học: Kết quả thực nghiệm chứng minh giải pháp tích hợp song song cả hai động cơ của đề tài là một chiến lược kiến trúc tối ưu: Động cơ Heuristic CPU cho phép bảo tàng số hóa nhanh hàng ngàn hiện vật đặt trong tủ kính với chi phí 0 đồng và tải cực mượt trên điện thoại; trong khi Động cơ TRELLIS GPU đóng vai trò mở rộng cho các bảo vật quốc gia có hình khối phức tạp khi có điều kiện hạ tầng.")

    add_heading_3(doc, "4.2.3. Kết quả đo đạc hiệu năng kết xuất và thời gian xử lý hệ thống")
    add_body_p(doc, "Nhóm tiến hành đo lường hiệu năng kỹ thuật bằng công cụ Chrome DevTools và các thiết bị di động thực tế tại khuôn viên bảo tàng:")

    p_cap_tbl42 = doc.add_paragraph()
    format_paragraph(p_cap_tbl42, space_before=6, space_after=3, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    p_cap_tbl42.paragraph_format.keep_with_next = True
    set_run_font(p_cap_tbl42.add_run("Bảng 4.2: Kết quả đo đạc hiệu năng kết xuất đồ họa và mức tiêu thụ tài nguyên đa thiết bị"), "Times New Roman", 12, bold=True, italic=True, color_rgb=COLOR_BLACK)

    tbl_4_2 = doc.add_table(rows=6, cols=5)
    tbl_4_2.style = 'Table Grid'
    tbl_4_2.alignment = WD_TABLE_ALIGNMENT.CENTER
    tbl_4_2.autofit = False
    set_table_borders(tbl_4_2, color="000000", sz="6")

    widths_4_2 = [Cm(4.0), Cm(2.5), Cm(2.8), Cm(3.0), Cm(3.7)]
    for r in tbl_4_2.rows:
        make_row_cant_split(r)
        for c_idx, w in enumerate(widths_4_2):
            r.cells[c_idx].width = w
            set_cell_margins(r.cells[c_idx], top=90, bottom=90, left=130, right=130)
            set_cell_vertical_alignment(r.cells[c_idx], "center")

    make_row_header(tbl_4_2.rows[0])

    headers_4_2 = ["Thiết bị và Môi trường", "Tốc độ khung hình (FPS)", "Thời gian tải Tour (4G)", "RAM ban đầu", "RAM sau khi qua 18 phòng"]
    for c_idx, h_text in enumerate(headers_4_2):
        cell = tbl_4_2.cell(0, c_idx)
        cell.paragraphs[0].text = ""
        p = cell.paragraphs[0]
        format_paragraph(p, space_before=4, space_after=4, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
        set_run_font(p.add_run(h_text), "Times New Roman", 10.5, bold=True, color_rgb=COLOR_BLACK)
        set_cell_background(cell, "EAECEF")

    data_4_2 = [
        ("Máy tính để bàn (Chrome 128 / Win 11)", "60,0 FPS", "0,82 giây", "145 MB", "158 MB (Ổn định mượt mà)"),
        ("Máy tính xách tay (Edge / macOS)", "59,8 FPS", "0,95 giây", "138 MB", "152 MB (Ổn định mượt mà)"),
        ("Điện thoại iPhone 14 (Safari iOS 17)", "58,5 FPS", "1,15 giây", "92 MB", "105 MB (Ổn định mượt mà)"),
        ("Điện thoại Samsung Galaxy A54 (Android 14)", "54,2 FPS", "1,28 giây", "88 MB", "98 MB (Ổn định mượt mà)"),
        ("Điện thoại Xiaomi Redmi Note 12 (Android 13)", "48,6 FPS", "1,42 giây", "82 MB", "94 MB (Ổn định mượt mà)")
    ]

    for r_idx, row_data in enumerate(data_4_2):
        for c_idx, val in enumerate(row_data):
            cell = tbl_4_2.cell(r_idx + 1, c_idx)
            cell.paragraphs[0].text = ""
            p = cell.paragraphs[0]
            align_choice = WD_ALIGN_PARAGRAPH.LEFT if c_idx == 0 else WD_ALIGN_PARAGRAPH.CENTER
            format_paragraph(p, space_before=3, space_after=3, line_spacing=1.15, align=align_choice, first_indent=0.0, left_indent=0.0)
            set_run_font(p.add_run(val), "Times New Roman", 10.5, bold=(c_idx == 0), color_rgb=COLOR_BLACK)

    add_body_p(doc, "Nhận xét kết quả đo lường hiệu năng:")
    add_bullet_item(doc, " Tốc độ khung hình kết xuất đồ họa luôn duy trì trên mức 48 FPS trên tất cả các thiết bị di động phổ thông và đạt chuẩn 60 FPS trên máy tính, đảm bảo trải nghiệm xoay nhìn không gian 360 độ hoàn toàn êm dịu, không giật cục.", bold_prefix="- Độ mượt mà kết xuất đồ họa (Rendering FPS):")
    add_bullet_item(doc, " Thời gian tải trang ban đầu và nạp không gian phòng qua mạng di động 4G tại bảo tàng dao động từ 0,82 đến 1,42 giây, đáp ứng xuất sắc chỉ tiêu kỹ thuật phi chức năng đặt ra (< 1,5 giây).", bold_prefix="- Thời gian đáp ứng mạng di động 4G:")
    add_bullet_item(doc, " Nhờ cơ chế chủ động giải phóng bộ nhớ (dispose() kết cấu và khối hình học), mức tiêu thụ RAM trên thiết bị di động chỉ tăng nhẹ dưới 15 MB sau khi người dùng đi xuyên suốt toàn bộ 18 gian phòng trưng bày, triệt tiêu hoàn toàn sự cố tràn bộ nhớ làm văng ứng dụng trình duyệt.", bold_prefix="- Quản trị bộ nhớ RAM thiết bị di động:")
    add_bullet_item(doc, " Tốc độ camera nhận diện và xác thực vé QR tại cửa bảo tàng đạt độ trễ trung bình 0,45 giây, giúp khâu soát vé đón tiếp khách diễn ra trơn tru, không gây ùn ứ tại cổng vào.", bold_prefix="- Hiệu năng quét vé camera QR:")

    # =========================================================================
    # CHƯƠNG 5: KẾT LUẬN VÀ HƯỚNG PHÁT TRIỂN
    # =========================================================================
    doc.add_page_break()
    add_heading_1(doc, "CHƯƠNG 5. KẾT LUẬN VÀ HƯỚNG PHÁT TRIỂN")

    add_body_p(doc, "Chương cuối của khóa luận tổng kết toàn bộ các kết quả đạt được về mặt khoa học công nghệ và giá trị thực tiễn sau quá trình nghiên cứu, xây dựng và triển khai thực tế hệ thống; đồng thời nhìn nhận khách quan các điểm còn hạn chế, đúc kết bài học kinh nghiệm và vạch ra các định hướng nghiên cứu phát triển khả thi trong tương lai.")

    add_heading_2(doc, "5.1. Tổng kết các kết quả đạt được")
    add_body_p(doc, 'Trải qua quá trình khảo sát thực địa tại Bảo tàng Lịch sử Thành phố Hồ Chí Minh, nghiên cứu lý thuyết chuyên sâu và hiện thực hóa phần mềm, đề tài "Hệ thống tham quan thực tế ảo 360° & Số hóa không gian di sản Bảo tàng Lịch sử TP. Hồ Chí Minh" đã hoàn thành xuất sắc toàn bộ các mục tiêu nghiên cứu và kỹ thuật đề ra ban đầu, mang lại những đóng góp rõ nét ở cả hai khía cạnh:')

    add_heading_3(doc, "5.1.1. Về mặt khoa học và làm chủ công nghệ")
    add_bullet_item(doc, " Đề tài đã làm chủ quy trình khép kín chuyển đổi video quay quét từ điện thoại thông thường thành ảnh toàn cảnh Equirectangular chuẩn tỷ lệ 2:1. Bằng cách tích hợp kỹ thuật nắn phẳng mặt trụ (Cylindrical Warping), trích xuất đặc trưng RootSIFT, ước lượng Homography lọc nhiễu qua RANSAC, tìm đường khâu cực tiểu Voronoi Seam và hòa trộn đa băng tần Laplacian, hệ thống đã giải quyết triệt để các thách thức nhiễu lóa do đèn rọi tủ kính bảo tàng và tự động nội suy vùng sàn Nadir với chi phí thiết bị 0 đồng.", bold_prefix="- Xây dựng thành công chuỗi thuật toán xử lý ảnh ghép 360° tự động:")
    add_bullet_item(doc, " Khóa luận đã hiện thực hóa sáng tạo hai phương pháp tiếp cận bổ trợ cho nhau: Động cơ Heuristic nội bộ (artifact_3d_generator.py) khai thác biến đổi khoảng cách Euclid và vòm cầu điều hòa trên CPU máy chủ, cho phép bóc tách và tạo mô hình 3D khép kín (.GLB) từ một ảnh chụp đơn trong thời gian cực ngắn (3 - 6 giây), dung lượng siêu nhẹ (2 - 5 MB), không phát sinh bất kỳ chi phí GPU nào; Động cơ AI Diffusion đám mây (trellisClient.ts) kết nối mô hình TRELLIS trên máy chủ GPU đám mây để suy diễn thể tích mặt sau cho các cổ vật phức tạp.", bold_prefix="- Tiên phong kiến trúc Đa Động cơ (Dual-Engine) trong tái tạo mô hình 3D cổ vật:")
    add_bullet_item(doc, " Ứng dụng thành công thư viện Three.js kết hợp giải thuật dẫn đường Dijkstra trên sơ đồ mặt bằng 18 gian phòng, tích hợp trợ lý trí tuệ nhân tạo Google Gemini 2.5 Flash qua cơ chế nạp ngữ cảnh nhẹ (Lightweight RAG). Hệ thống duy trì ổn định tốc độ khung hình từ 48 đến 60 FPS và thời gian nạp phòng dưới 1,5 giây trên mạng di động 4G nhờ cơ chế dọn dẹp giải phóng bộ nhớ GPU (dispose()) nghiêm ngặt.", bold_prefix="- Tối ưu hóa hiệu năng kết xuất đồ họa WebGL phân tán:")

    add_heading_3(doc, "5.1.2. Về mặt giá trị thực tiễn cho bảo tàng và cộng đồng")
    add_bullet_item(doc, " Đề tài đã hoàn thành số hóa chi tiết toàn bộ khuôn viên và 18 gian phòng chuyên đề của Bảo tàng Lịch sử TP.HCM, bao gồm từ thời Tiền sử, Dựng nước Hùng Vương, các triều đại Ngô - Đinh - Tiền Lê - Lý - Trần - Hậu Lê - Tây Sơn - Nguyễn, đến các bộ sưu tập văn hóa đặc sắc như Văn hóa Champa, Văn hóa Óc Eo - Phù Nam, Tượng Phật giáo châu Á và Cổ vật Vương Hồng Sển.", bold_prefix="- Số hóa trọn vẹn 18 gian phòng trưng bày liên hoàn:")
    add_bullet_item(doc, " Không dừng lại ở một ứng dụng tham quan đơn thuần, hệ thống mang đến một hệ sinh thái chuyển đổi số hoàn chỉnh cho bảo tàng: từ hệ thống quản trị nội dung CMS trực quan, kiểm soát thương hiệu, quản lý hiện vật, thuyết minh âm thanh song ngữ, đến cổng bán vé trực tuyến thanh toán tự động qua mã VietQR (PayOS) và quét mã QR soát vé tại cửa ra vào qua camera điện thoại di động.", bold_prefix="- Cung cấp giải pháp chuyển đổi số toàn diện chi phí thấp:")
    add_bullet_item(doc, " Hệ thống giúp xóa bỏ rào cản địa lý và kinh tế, mở ra cơ hội tiếp cận kho tàng tri thức lịch sử ngàn năm của dân tộc cho hàng triệu học sinh, sinh viên, các nhà nghiên cứu và du khách quốc tế mọi lúc mọi nơi ngay trên trình duyệt web mà không cần cài đặt phần mềm phức tạp.", bold_prefix="- Góp phần lan tỏa và bảo tồn di sản văn hóa dân tộc:")

    add_heading_2(doc, "5.2. Các mặt hạn chế và bài học kinh nghiệm")
    add_body_p(doc, "Bên cạnh những kết quả tích cực đã đạt được, nhóm tác giả thẳng thắn nhìn nhận hệ thống vẫn còn một số điểm hạn chế kỹ thuật cần tiếp tục khắc phục:")

    add_heading_3(doc, "5.2.1. Những hạn chế kỹ thuật hiện tại")
    add_bullet_item(doc, " Môi trường trưng bày thực tế tại bảo tàng sử dụng hệ thống đèn rọi vàng công suất cao chiếu thẳng vào các tủ kính chống trộm. Khi lia máy quay video bằng điện thoại, các điểm phản xạ ánh sáng mạnh trên mặt kính đôi khi gây ra hiện tượng lóa cục bộ, đòi hỏi người quay phải giữ tốc độ di chuyển thật đều tay và chọn góc quay tránh phản xạ trực tiếp.", bold_prefix="- Hạn chế về ánh sáng và phản quang trong không gian bảo tàng:")
    add_bullet_item(doc, " Do bản chất toán học của phương pháp biến đổi khoảng cách Euclid dựa trên một góc nhìn duy nhất (Single-view Depth Inpainting), mặt sau của mô hình 3D sinh bởi động cơ CPU nội bộ mang tính đối xứng trơn tru với mặt trước. Đối với các hiện vật rỗng ruột phức tạp (như bên trong lòng đỉnh đồng hoặc mặt sau của tượng tròn có hoa văn riêng biệt), phương pháp này chưa thể tái tạo chi tiết mặt sau mà cần chuyển tiếp sang Động cơ AI GPU đám mây.", bold_prefix="- Giới hạn hình học mặt sau của Động cơ 3D Heuristic:")
    add_bullet_item(doc, " Quy trình ghép ảnh 360 độ từ video đòi hỏi khối lượng tính toán ma trận lớn trên CPU máy chủ VPS. Khi nhiều tác vụ ghép ảnh được gửi lên cùng lúc, hàng đợi Redis cần từ 2 đến 4 phút để hoàn tất một bức ảnh Equirectangular độ phân giải siêu nét 8192 x 4096 px.", bold_prefix="- Độ trễ xử lý hàng đợi ghép ảnh khi tải cao:")

    add_heading_3(doc, "5.2.2. Bài học rút ra trong quá trình triển khai")
    add_bullet_item(doc, " Quá trình tác nghiệp thực tế qua 4 đợt tại bảo tàng đã chứng minh rằng việc khảo sát kỹ lưỡng ánh sáng, kiến trúc cửa thông phòng và quy định bảo mật hiện vật đóng vai trò quyết định đến sự thành bại của thuật toán thị giác máy tính, thay vì chỉ thử nghiệm trong điều kiện phòng thí nghiệm lý tưởng.", bold_prefix="- Tính thực tế của dữ liệu khảo sát hiện trường:")
    add_bullet_item(doc, " Việc quản trị vòng đời đối tượng Three.js và giải phóng tài nguyên bộ nhớ đệm (Cache/Texture/Geometry) là chìa khóa sống còn giúp ứng dụng 3D đồ họa nặng vận hành mượt mà trên các dòng điện thoại thông minh phổ thông có dung lượng RAM khiêm tốn.", bold_prefix="- Tầm quan trọng của việc tối ưu tài nguyên thiết bị đầu cuối:")

    add_heading_2(doc, "5.3. Hướng phát triển trong tương lai")
    add_body_p(doc, "Nhằm nâng tầm hệ thống và đáp ứng tốt hơn nữa xu thế phát triển của công nghệ bảo tàng số (Smart Digital Museum) trên thế giới, nhóm định hướng mở rộng nghiên cứu theo 2 trục đột phá công nghệ:")

    add_heading_3(doc, "5.3.1. Tích hợp công nghệ thực tế ảo mở rộng WebXR và kính thông minh")
    add_bullet_item(doc, " Nâng cấp lõi đồ họa Three.js để tương thích hoàn toàn với chuẩn mở WebXR Device API, cho phép người dùng kích hoạt chế độ không gian nổi (Immersive VR Mode) khi đeo các loại kính thực tế ảo như Meta Quest, Apple Vision Pro hoặc kính Cardboard giá rẻ gắn điện thoại.", bold_prefix="- Hỗ trợ thiết bị đeo thực tế ảo và thực tế tăng cường:")
    add_bullet_item(doc, " Phát triển tính năng thực tế tăng cường (Augmented Reality - AR) cho phép khách tham quan khi đến bảo tàng có thể dùng camera điện thoại hướng vào hiện vật để xem ngay mô hình 3D tương tác nhảy ra khỏi tủ kính, xem video tái hiện lịch sử hoặc quan sát cổ vật được phục chế nguyên bản thời hoàng kim.", bold_prefix="- Tương tác AR trong không gian thực tế:")

    add_heading_3(doc, "5.3.2. Nâng cấp mô hình 3D Gaussian Splatting và trợ lý tương tác giọng nói")
    add_bullet_item(doc, " Nghiên cứu ứng dụng kỹ thuật 3D Gaussian Splatting tiên tiến nhất hiện nay để thay thế ảnh toàn cảnh tĩnh dạng cầu bằng một đám mây hạt Gaussian liên tục 6 bậc tự do (6-DoF), cho phép người tham quan có thể tự do di chuyển bước đi tự nhiên trong gian phòng bảo tàng với chất lượng ánh sáng chân thực như đang đứng tại hiện trường.", bold_prefix="- Ứng dụng công nghệ tái tạo không gian 3D Gaussian Splatting (3DGS):")
    add_bullet_item(doc, " Nâng cấp trợ lý AI Google Gemini tích hợp mô hình tổng hợp giọng nói tự nhiên (Text-to-Speech) đa vùng miền (Bắc - Trung - Nam) và mở rộng thêm các ngôn ngữ quốc tế (tiếng Pháp, tiếng Nhật, tiếng Trung, tiếng Hàn), tạo nên trải nghiệm thuyết minh tự động cá nhân hóa theo từng bước chân của du khách.", bold_prefix="- Tự động hóa thuyết minh đa ngôn ngữ qua giọng nói trí tuệ nhân tạo (AI Voice):")

    # =========================================================================
    # TÀI LIỆU THAM KHẢO
    # =========================================================================
    doc.add_page_break()
    add_heading_1(doc, "TÀI LIỆU THAM KHẢO")

    references_data = [
        ("[1]", "R. Szeliski", "Computer Vision: Algorithms and Applications, 2nd ed", "Cham, Switzerland: Springer, 2022."),
        ("[2]", "D. G. Lowe", '"Distinctive image features from scale-invariant keypoints"', "International Journal of Computer Vision, vol. 60, no. 2, pp. 91–110, 2004."),
        ("[3]", "R. Arandjelović and A. Zisserman", '"Three things everyone should know to improve object retrieval"', "in Proceedings of the IEEE Conference on Computer Vision and Pattern Recognition (CVPR), Providence, RI, USA, 2012, pp. 291–298."),
        ("[4]", "M. A. Fischler and R. C. Bolles", '"Random sample consensus: a paradigm for model fitting with applications to image analysis and automated cartography"', "Communications of the ACM, vol. 24, no. 6, pp. 381–395, 1981."),
        ("[5]", "P. J. Burt and E. H. Adelson", '"A multiresolution spline with application to image mosaics"', "ACM Transactions on Graphics (TOG), vol. 2, no. 4, pp. 217–236, 1983."),
        ("[6]", "X. Qin, Z. Zhang, C. Huang, M. Dehghan, O. R. Zaiane, and M. Jagersand", '"U2-Net: Going deeper with nested U-structure for salient object detection"', "Pattern Recognition, vol. 106, p. 107404, 2020."),
        ("[7]", "J. Xiang et al.", '"TRELLIS: Structured 3D Latents for Scalable and Versatile 3D Generation"', "arXiv preprint arXiv:2412.01506, 2024."),
        ("[8]", "J. L. Schönberger and J.-M. Frahm", '"Structure-from-motion revisited"', "in Proceedings of the IEEE Conference on Computer Vision and Pattern Recognition (CVPR), Las Vegas, NV, USA, 2016, pp. 594–604."),
        ("[9]", "D. Cernea", "OpenMVS: Multi-View Stereo Reconstruction Library", "2020. [Trực tuyến]. Địa chỉ: https://cdcseacave.github.io/openMVS/ [Truy cập 10/11/2026]."),
        ("[10]", "R. Cabello et al.", "Three.js - JavaScript 3D Library Documentation", "2026. [Trực tuyến]. Địa chỉ: https://threejs.org/docs/ [Truy cập 10/11/2026]."),
        ("[11]", "Khronos Group", "WebGL 2.0 Specification", "Khronos Open Web Standards, 2023. [Trực tuyến]. Địa chỉ: https://www.khronos.org/registry/webgl/specs/latest/2.0/ [Truy cập 10/11/2026]."),
        ("[12]", "Khronos Group", "glTF 2.0 Specification: The 3D Formats for the Web", "Khronos 3D Standards, 2022. [Trực tuyến]. Địa chỉ: https://www.khronos.org/gltf/ [Truy cập 10/11/2026]."),
        ("[13]", "M. Stonebraker and G. Kemnitz", '"The design of the POSTGRES storage system"', "in Proceedings of the 17th International Conference on Very Large Data Bases (VLDB), Barcelona, Spain, 1991, pp. 289–300."),
        ("[14]", "J. L. Carlson", "Redis in Action", "Shelter Island, NY: Manning Publications, 2013."),
        ("[15]", "Gemini Team, Google", '"Gemini: A Family of Highly Capable Multimodal Models"', "arXiv preprint arXiv:2312.11805, 2023."),
        ("[16]", "Bảo tàng Lịch sử Thành phố Hồ Chí Minh", "Kỷ yếu nghiên cứu và bảo tồn di sản văn hóa Nam Bộ", "TP. Hồ Chí Minh: NXB Tổng hợp TP. Hồ Chí Minh, 2022."),
        ("[17]", "E. W. Dijkstra", '"A note on two problems in connexion with graphs"', "Numerische Mathematik, vol. 1, no. 1, pp. 269–271, 1959."),
        ("[18]", "Ngân hàng Nhà nước Việt Nam", '"Quyết định số 130/QĐ-NHNN về Tiêu chuẩn kỹ thuật thanh toán qua mã phản hồi nhanh (VietQR)"', "Hà Nội, 2021.")
    ]

    for ref_num, auth, tit, pub in references_data:
        add_reference_item(doc, ref_num, auth, tit, pub)

    # =========================================================================
    # PHỤ LỤC
    # =========================================================================
    doc.add_page_break()
    add_heading_1(doc, "PHỤ LỤC")

    add_heading_2(doc, "PHỤ LỤC A: BẢNG KẾ HOẠCH THỰC HIỆN VÀ PHÂN CÔNG ĐÁNH GIÁ NHIỆM VỤ KHÓA LUẬN")
    add_body_p(doc, "Bảng sau đây tổng kết toàn bộ tiến độ thực hiện đề tài qua các giai đoạn nghiên cứu, 4 đợt tác nghiệp thực địa tại Bảo tàng Lịch sử TP. Hồ Chí Minh và ma trận phân công chi tiết giữa 2 sinh viên thực hiện:")

    p_cap_tblA1 = doc.add_paragraph()
    format_paragraph(p_cap_tblA1, space_before=6, space_after=3, line_spacing=1.15, align=WD_ALIGN_PARAGRAPH.CENTER, first_indent=0.0, left_indent=0.0)
    p_cap_tblA1.paragraph_format.keep_with_next = True
    set_run_font(p_cap_tblA1.add_run("Bảng A.1: Bảng phân công nhiệm vụ và tiến độ thực hiện đề tài qua 4 đợt tác nghiệp"), "Times New Roman", 12, bold=True, italic=True, color_rgb=COLOR_BLACK)

    tbl_A_1 = doc.add_table(rows=5, cols=4)
    tbl_A_1.style = 'Table Grid'
    tbl_A_1.alignment = WD_TABLE_ALIGNMENT.CENTER
    tbl_A_1.autofit = False
    set_table_borders(tbl_A_1, color="000000", sz="6")

    widths_A_1 = [Cm(3.8), Cm(6.5), Cm(3.7), Cm(2.0)]
    for r in tbl_A_1.rows:
        make_row_cant_split(r)
        for c_idx, w in enumerate(widths_A_1):
            r.cells[c_idx].width = w
            set_cell_margins(r.cells[c_idx], top=90, bottom=90, left=130, right=130)
            set_cell_vertical_alignment(r.cells[c_idx], "center")

    make_row_header(tbl_A_1.rows[0])

