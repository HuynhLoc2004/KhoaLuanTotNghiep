{
  "name": "@hcmc-museum/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "lint": "eslint src test",
    "test": "node --test dist/test/component.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false"
  }
}
