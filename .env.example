# ==============================================================================
# HCMC HISTORY MUSEUM 3D PLATFORM — ENVIRONMENT CONFIGURATION (LOCAL DEV)
# ==============================================================================
# COPY THIS FILE TO .env OR .env.local FOR LOCAL DEVELOPMENT
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!
# ==============================================================================

# System Node Environment
NODE_ENV=development
PORT=3000
WEB_PORT=3001
ADMIN_PORT=3002

# Keycloak IAM Identity Server (Local Docker Compose)
KEYCLOAK_URL=http://localhost:18080
KEYCLOAK_REALM=hcmc-museum
KEYCLOAK_CLIENT_ID=hcmc-museum-web
KEYCLOAK_CLIENT_SECRET=

# PostgreSQL Database + pgvector Extension
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hcmc_museum
DB_MAX_CONNECTIONS=10

# AI Service & Hybrid RAG Engine (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=
OPENAI_API_KEY=

# Passwordless OTP Service
OTP_EXPIRY_SECONDS=300
OTP_DEMO_CODE=123456

# Redis Cache Service
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# 3D VIRTUAL TOUR & CLOUD STORAGE (Cloudflare R2 / Cloudinary)
# ==============================================================================
# Cloudflare R2 (S3-compatible, Free 10GB, Zero Egress Fees - Recommended for .splat/.ply)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=museum-tours
R2_PUBLIC_DOMAIN=https://pub-your-bucket-id.r2.dev

# Cloudinary (Alternative for high-res photo uploads and CDN transformations)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
