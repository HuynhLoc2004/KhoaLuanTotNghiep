# Runtime mode shared by server-side JavaScript processes.
NODE_ENV=

# Backend data stores and queue/cache connection strings.
DATABASE_URL=
MONGODB_URI=
REDIS_URL=

# Server-only authentication keys and Google OAuth credentials.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only Cloudinary credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-only credential for the selected AI provider.
AI_PROVIDER_API_KEY=

# Browser-safe service origins; never place credentials in public variables.
PUBLIC_API_ORIGIN=
MEDIA_ORIGIN=
