# Copy to infra/.env and replace every change-me value before starting Compose.
# This file contains placeholders only. Never commit infra/.env.

POSTGRES_DB=museum
POSTGRES_USER=museum_app
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST_PORT=15432

MONGO_INITDB_DATABASE=museum
MONGO_INITDB_ROOT_USERNAME=museum_admin
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo
MONGO_HOST_PORT=27018

REDIS_PASSWORD=change-me-redis
REDIS_HOST_PORT=16379

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_HOST_PORT=18080
KEYCLOAK_REALM=hcmc-museum
KEYCLOAK_CLIENT_ID=hcmc-museum-web
KEYCLOAK_URL=http://localhost:18080

